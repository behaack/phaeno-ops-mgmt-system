{
  "name": "frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:https": "vite dev --host 127.0.0.1 --port 3000",
    "build": "node scripts/generate-documentation.mjs --ui-only && vite build",
    "preview": "vite preview",
    "lint": "eslint . && pnpm ui:check",
    "lint:ci": "eslint . --max-warnings=0 && pnpm ui:check",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "docs:generate": "node scripts/generate-documentation.mjs",
    "docs:check": "node scripts/generate-documentation.mjs --check",
    "predev": "node scripts/generate-documentation.mjs --ui-only",
    "ui:gallery": "vite --config ui-gallery/vite.config.ts",
    "ui:gallery:build": "vite build --config ui-gallery/vite.config.ts",
    "ui:check": "node scripts/check-ui-drift.mjs",
    "ui:build:check": "node scripts/check-ui-build.mjs",
    "ui:test": "node --test scripts/ui-drift.test.mjs",
    "ui:test:components": "vitest run src/lib/display-format.test.ts src/components/ui/standardization.test.tsx src/features/orders/order-status.test.ts src/features/file-management/ReleasedDeliverablesPage.test.tsx --maxWorkers=2",
    "ui:test:browser": "playwright test --config playwright.ui-gallery.config.ts",
    "ui:test:visual": "node scripts/check-ui-visual.mjs && playwright test --config playwright.ui-visual.config.ts",
    "ui:visual:check": "node scripts/check-ui-visual.mjs",
    "ui:visual:review": "node scripts/check-ui-visual.mjs --record-reviewed"
  },
  "dependencies": {
    "@bwip-js/browser": "4.11.4",
    "@clerk/react": "^6.12.8",
    "@dnd-kit/react": "0.5.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@microsoft/signalr": "10.0.11",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "^1.168.42",
    "axios": "^1.15.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "nitro": "3.0.260610-beta",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.74.0",
    "shadcn": "^4.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
