{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "git": {
    "deploymentEnabled": {
      "codex/portal-documentation-search-release": false
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.phaenobiotech.com/api/:path*"
    }
  ]
}
