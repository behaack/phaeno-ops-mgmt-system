+        }
+        // Engine processes have stopped. Publication and verification never restart a completed stage.
+        if (journal.phase == "Collecting") {
+            if (journal.provenance_report_json is null) {
+                journal.provenance_report_json = JsonTools.SerializeIndented(new { job_id = start.job_id, scientific_use = true,
+                    input_manifest_sha256 = start.input_manifest.sha256, profile_sha256 = profile.DefinitionHash(), parameters_sha256 = JsonTools.CanonicalHash(start.recipe.parameters),
+                    dataset_sha256 = ScientificProfile.DatasetHash(manifest), qc_criteria_sha256 = profile.qc_criteria.sha256,
+                    approval = profile.approval, provenance = Provenance(profile), stages = journal.stages.Select(s => new { s.name, s.result }) });
+                Save();
+            }
+            journal.artifacts = await CollectAsync(profile, start, manifest, work, journal, ct);
