new file mode 100644
index 00000000..7d0cc6ec
--- /dev/null
+++ b/apps/pseq_server/deploy/prepare-release.sh
@@ -0,0 +1,46 @@
+#!/bin/sh
+set -eu
+# Preparation only: no installation, service start, active-pointer change, ledger access or pilot.
+if test "$#" -ne 3; then
+    echo 'Usage: prepare-release.sh <pipeline-source> <exact-source-commit> <new-empty-release-directory>' >&2
+    exit 2
+fi
+source_root=$(realpath "$1")
+commit=$2
+release=$(realpath -m "$3")
+test "$(uname -s)" = Linux
+test "$(uname -m)" = aarch64
+test "$(git -C "$source_root" rev-parse HEAD)" = "$commit"
+test -z "$(git -C "$source_root" status --porcelain -- apps/pseq_server apps/phaeno Cargo.lock)"
+test ! -e "$release"
+command -v dotnet >/dev/null
+cargo_path=${CARGO:-"$HOME/.cargo/bin/cargo"}
+test -x "$cargo_path"
+test -f "$source_root/apps/phaeno/Cargo.toml"
+mkdir -m 700 "$release"
+dotnet publish "$source_root/apps/pseq_server/dps/dps.csproj" -c Release -r linux-arm64 --self-contained true \
+    -p:ContinuousIntegrationBuild=true "-p:SourceRevisionId=$commit" "-p:InformationalVersion=$commit" -o "$release/dps"
+"$cargo_path" build --locked --release --manifest-path "$source_root/apps/phaeno/Cargo.toml"
+# The Cargo workspace may centralize target output. Resolve it from Cargo, never guess a demo path.
+target=$("$cargo_path" metadata --locked --offline --no-deps --format-version 1 --manifest-path "$source_root/apps/phaeno/Cargo.toml" | python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])')
+test -x "$target/release/phaeno"
+mkdir -m 700 "$release/science"
+cp "$target/release/phaeno" "$release/science/phaeno"
+cp "$source_root/apps/pseq_server/deploy/report-exit.sh" "$release/dps/report-exit.sh"
+chmod 500 "$release/science/phaeno" "$release/dps/report-exit.sh"
+python3 - "$release" "$commit" <<'PY'
+import datetime, hashlib, json, pathlib, platform, sys
+root = pathlib.Path(sys.argv[1])
+files = []
+for path in sorted(root.rglob('*')):
+    if path.is_file():
+        digest = hashlib.sha256()
+        with path.open('rb') as stream:
+            for chunk in iter(lambda: stream.read(1024*1024), b''):
+                digest.update(chunk)
+        files.append({'path': str(path.relative_to(root)), 'sha256': digest.hexdigest(), 'size_bytes': path.stat().st_size})
+receipt = {'source_commit': sys.argv[2], 'architecture': platform.machine(), 'prepared_at_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+           'files': files, 'scientifically_qualified': False, 'activated': False}
+(root/'dps'/'build-receipt.json').write_text(json.dumps(receipt, indent=2)+'\n')
+PY
+echo 'Candidate release prepared only. Tool/reference qualification, preserving activation and pilot approvals remain required.'
