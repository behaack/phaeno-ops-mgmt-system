+    private sealed class ObjectHandler : HttpMessageHandler
+    {
+        internal readonly Dictionary<string, byte[]> Data = new(StringComparer.Ordinal);
+        internal bool CorruptGet, CreateOnly, Streamed;
+        internal string? LastQuery;
+        internal int PutCount;
+        internal int FailVerificationAtPut;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct)
+        {
+            var key = Uri.UnescapeDataString(request.RequestUri!.AbsolutePath.TrimStart('/')); LastQuery = request.RequestUri.Query;
+            if (request.Method == HttpMethod.Put) {
+                PutCount++; CreateOnly = request.Headers.IfNoneMatch.Any(x => x.Tag == "*"); Streamed = request.Content is StreamContent;
+                if (Data.ContainsKey(key) && CreateOnly) return new(HttpStatusCode.PreconditionFailed);
+                Data[key] = await request.Content!.ReadAsByteArrayAsync(ct);
+                var put = new HttpResponseMessage(HttpStatusCode.OK); put.Headers.Add("x-amz-version-id", "v1"); return put;
+            }
+            var bytes = Data[key];
+            if (CorruptGet || FailVerificationAtPut > 0 && PutCount == FailVerificationAtPut) {
+                bytes = Encoding.ASCII.GetBytes("wrong bytes"); FailVerificationAtPut = 0;
+            }
+            var response = new HttpResponseMessage(HttpStatusCode.OK) { Content = new ByteArrayContent(bytes) };
+            response.Headers.Add("x-amz-version-id", "v1"); return response;
+        }
+    }
