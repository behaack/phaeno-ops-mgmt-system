+            await MaterializeAsync(manifest, profile, work, runToken);
+            await progress(10);
+            for (int i = 0; i < journal.stages.Count; i++) {
+                var stage = journal.stages[i];
+                if (stage.state == "Complete") continue;
+                runToken.ThrowIfCancellationRequested();
+                stage.state = "InFlight"; Save(); // No native invocation before this durable intent.
+                StageResult result;
+                try { result = await ScientificProcess.RunAsync(new() { nonce = stage.nonce, workspace = work, index = i, profile = profile }, runToken); }
+                catch (OperationCanceledException) when (ct.IsCancellationRequested) {
+                    // RunAsync throws cancellation only after it has fenced its process group.
+                    stage.state = "Cancelled"; journal.stopped_at_utc = JsonTools.UtcNowString(); journal.failure_code = "scientific_cancelled"; Save(); throw;
+                }
+                catch (OperationCanceledException) { stage.state = "Failed"; journal.stopped_at_utc = JsonTools.UtcNowString(); journal.failure_code = "scientific_execution_budget_exceeded"; Save(); throw new InvalidOperationException(journal.failure_code); }
+                catch (ScientificResourceException) { stage.state = "Failed"; journal.stopped_at_utc = JsonTools.UtcNowString(); journal.failure_code = "scientific_scratch_budget_exceeded"; Save(); throw new InvalidOperationException(journal.failure_code); }
