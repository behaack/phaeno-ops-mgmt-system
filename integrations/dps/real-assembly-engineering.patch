@@ -0,0 +1,209 @@
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+
+namespace Dps;
+
+internal sealed class ExecutionHeldException(string code) : Exception(code);
+internal sealed class ScientificResourceException : Exception;
+
+internal sealed class StageLaunch
+{
+    public string nonce = "";
+    public string workspace = "";
+    public int index;
+    public ScientificProfile profile = new();
+}
+
+internal sealed class StageOwner
+{
+    public string nonce = "";
+    public int pid;
+    public long process_start_ticks;
+    public string boot_id = "";
+}
+
+internal sealed class StageResult
+{
+    public string nonce = "";
+    public int exit_code;
+    public string started_at_utc = "";
+    public string stopped_at_utc = "";
+    public string? fenced_at_utc;
+}
+
+// Each native stage gets its own session. Recovery never reruns an in-flight stage.
+internal static class ScientificProcess
+{
+    [DllImport("libc", SetLastError = true)] private static extern int setsid();
+    [DllImport("libc", SetLastError = true)] private static extern int kill(int pid, int signal);
+
+    internal static string StagePath(string workspace, int index, string suffix) => SafePath.Child(workspace, $"stage-{index:D2}.{suffix}");
+
+    internal static async Task<StageResult> RunAsync(StageLaunch launch, CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested();
+        if (!OperatingSystem.IsLinux()) throw new InvalidOperationException("Scientific execution requires the qualified Linux service.");
+        var launchPath = StagePath(launch.workspace, launch.index, "launch.json");
+        DurableFile.Write(launchPath, JsonTools.Serialize(launch));
+        var executable = Environment.ProcessPath ?? throw new InvalidOperationException("Worker executable is unavailable.");
+        if (Path.GetFileNameWithoutExtension(executable) is not ("dotnet" or "dps"))
+            executable = Path.GetFullPath(Path.Combine(RuntimeEnvironment.GetRuntimeDirectory(), "..", "..", "..", "dotnet"));
+        var info = new ProcessStartInfo(executable) { UseShellExecute = false, WorkingDirectory = launch.workspace };
+        if (Path.GetFileNameWithoutExtension(executable) == "dotnet") info.ArgumentList.Add(typeof(ScientificProcess).Assembly.Location);
+        info.ArgumentList.Add("--scientific-stage"); info.ArgumentList.Add(launchPath); info.ArgumentList.Add(launch.nonce);
+        // No broker keys, AWS keys, certificate passwords or ambient scientific data paths.
+        info.Environment.Clear();
+        using var process = Process.Start(info) ?? throw new InvalidOperationException("Stage host did not start.");
+        var startTicks = ProcessStartTicks(process.Id);
+        using var limits = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        bool exceeded = false;
+        var monitor = MonitorAsync();
+        try { await process.WaitForExitAsync(limits.Token); }
+        catch (OperationCanceledException) {
+            SignalOwned(process, launch, startTicks, 15);
+            try { await process.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(10)); }
+            catch (TimeoutException) { SignalOwned(process, launch, startTicks, 9); await process.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(10)); }
+            await FenceGroupAsync(launch, process.Id, startTicks);
+            if (exceeded) throw new ScientificResourceException();
+            throw;
+        }
+        finally { limits.Cancel(); await monitor; }
+        await FenceGroupAsync(launch, process.Id, startTicks);
+        var resultPath = StagePath(launch.workspace, launch.index, "result.json");
+        if (!File.Exists(resultPath)) throw new ExecutionHeldException("scientific_stage_result_missing");
+        var result = JsonTools.Deserialize<StageResult>(File.ReadAllText(resultPath));
+        if (result is null || result.nonce != launch.nonce || process.ExitCode != result.exit_code)
+            throw new ExecutionHeldException("scientific_stage_result_ambiguous");
+        result.fenced_at_utc = JsonTools.UtcNowString();
+        DurableFile.Write(StagePath(launch.workspace, launch.index, "fence.json"), JsonTools.Serialize(new {
+            launch.nonce, pid = process.Id, process_start_ticks = startTicks, result.fenced_at_utc
+        }));
+        return result;
+
+        async Task MonitorAsync()
+        {
+            try {
+                while (!limits.IsCancellationRequested) {
+                    long bytes = 0;
+                    foreach (var file in Directory.EnumerateFiles(launch.workspace, "*", new EnumerationOptions { RecurseSubdirectories = true, AttributesToSkip = FileAttributes.ReparsePoint })) {
+                        long size; try { size = new FileInfo(file).Length; } catch (FileNotFoundException) { continue; }
+                        if (size > launch.profile.maximum_workspace_bytes - bytes) { exceeded = true; break; } bytes += size;
+                    }
+                    if (exceeded || new DriveInfo(Path.GetPathRoot(launch.workspace)!).AvailableFreeSpace < launch.profile.minimum_free_disk_bytes) {
+                        exceeded = true; limits.Cancel(); return;
+                    }
+                    await Task.Delay(1000, limits.Token);
+                }
+            } catch (OperationCanceledException) when (limits.IsCancellationRequested) { }
+            catch { exceeded = true; limits.Cancel(); }
+        }
+    }
+
+    private static StageOwner Owner(StageLaunch launch, int pid, long startTicks)
+    {
+        var path = StagePath(launch.workspace, launch.index, "owner.json");
+        if (!File.Exists(path)) throw new ExecutionHeldException("scientific_process_ownership_missing");
+        var owner = JsonTools.Deserialize<StageOwner>(File.ReadAllText(path));
+        if (owner is null || owner.nonce != launch.nonce || owner.pid != pid || owner.process_start_ticks != startTicks
+            || owner.boot_id != File.ReadAllText("/proc/sys/kernel/random/boot_id").Trim())
+            throw new ExecutionHeldException("scientific_process_ownership_ambiguous");
+        return owner;
+    }
+
+    private static void SignalOwned(Process process, StageLaunch launch, long ticks, int signal)
+    {
+        // Before owner publication the host has not launched the engine. Never signal a stale PID.
+        if (!File.Exists(StagePath(launch.workspace, launch.index, "owner.json"))) {
+            if (!process.HasExited) process.Kill(entireProcessTree: true);
+            return;
+        }
+        Owner(launch, process.Id, ticks);
+        if (kill(-process.Id, signal) != 0 && Marshal.GetLastPInvokeError() != 3)
+            throw new ExecutionHeldException("scientific_process_fence_failed");
+    }
+
+    private static long ProcessStartTicks(int pid)
+    {
+        var text = File.ReadAllText($"/proc/{pid}/stat");
+        return long.Parse(text[(text.LastIndexOf(')') + 2)..].Split(' ')[19], System.Globalization.CultureInfo.InvariantCulture);
+    }
+
+    private static async Task FenceGroupAsync(StageLaunch launch, int pid, long ticks)
+    {
+        Owner(launch, pid, ticks);
+        if (kill(-pid, 9) != 0 && Marshal.GetLastPInvokeError() != 3)
+            throw new ExecutionHeldException("scientific_process_fence_failed");
+        // Zombies have stopped and cannot compute. Live residual members require reconciliation.
+        for (int poll = 0; poll < 100; poll++) {
+          bool live = false;
+          foreach (var directory in Directory.EnumerateDirectories("/proc")) {
+            if (!int.TryParse(Path.GetFileName(directory), out _)) continue;
+            try {
+                var text = File.ReadAllText(Path.Combine(directory, "stat"));
+                var fields = text[(text.LastIndexOf(')') + 2)..].Split(' ');
+                if (fields[0] != "Z" && int.Parse(fields[2]) == pid) live = true;
+            } catch (IOException) { } catch (UnauthorizedAccessException) { }
+          }
+          if (!live) return;
+          await Task.Delay(50);
+        }
+        throw new ExecutionHeldException("scientific_process_group_still_running");
+    }
+
+    // Invoked before configuration loading; this host has no MQTT client or ledger writer.
+    internal static async Task<int> HostAsync(string launchPath, string nonce)
+    {
+        if (!OperatingSystem.IsLinux() || setsid() != Environment.ProcessId) return 125;
+        SafePath.NoLinks(launchPath);
+        var launch = JsonTools.Deserialize<StageLaunch>(File.ReadAllText(launchPath)) ?? throw new InvalidOperationException();
+        if (launch.nonce != nonce || launchPath != StagePath(launch.workspace, launch.index, "launch.json")) return 125;
+        var profile = launch.profile;
+        if (profile.ReadinessReason() is not null || launch.index < 0 || launch.index >= profile.stages.Count) return 125;
+        var owner = new StageOwner { nonce = nonce, pid = Environment.ProcessId,
+            process_start_ticks = ProcessStartTicks(Environment.ProcessId),
+            boot_id = File.ReadAllText("/proc/sys/kernel/random/boot_id").Trim() };
+        DurableFile.Write(StagePath(launch.workspace, launch.index, "owner.json"), JsonTools.Serialize(owner));
+        using var cancelled = new CancellationTokenSource(TimeSpan.FromSeconds(profile.maximum_run_seconds));
+        using var term = PosixSignalRegistration.Create(PosixSignal.SIGTERM, c => { c.Cancel = true; cancelled.Cancel(); });
+        using var interrupt = PosixSignalRegistration.Create(PosixSignal.SIGINT, c => { c.Cancel = true; cancelled.Cancel(); });
+        var work = SafePath.Child(launch.workspace, "native");
+        var info = new ProcessStartInfo(profile.engine.path) { UseShellExecute = false, WorkingDirectory = work,
+            RedirectStandardOutput = true, RedirectStandardError = true };
+        info.Environment.Clear();
+        info.Environment["PATH"] = string.Join(':', profile.tools.Append(profile.engine).Select(p => Path.GetDirectoryName(p.path)).Distinct());
+        info.Environment["HOME"] = work;
+        info.Environment["TMPDIR"] = SafePath.Child(launch.workspace, "scratch");
+        info.Environment["DPS_BINDINGS_PATH"] = SafePath.Child(launch.workspace, "bindings.json");
+        info.Environment["DPS_PARAMETERS_PATH"] = SafePath.Child(launch.workspace, "parameters.json");
+        foreach (var argument in profile.stages[launch.index].arguments) info.ArgumentList.Add(argument
+            .Replace("{bindings}", info.Environment["DPS_BINDINGS_PATH"], StringComparison.Ordinal)
+            .Replace("{parameters}", info.Environment["DPS_PARAMETERS_PATH"], StringComparison.Ordinal)
+            .Replace("{workspace}", work, StringComparison.Ordinal));
+        var result = new StageResult { nonce = nonce, started_at_utc = JsonTools.UtcNowString() };
+        using var process = Process.Start(info) ?? throw new InvalidOperationException();
+        Task stdout = CopyBoundedAsync(process.StandardOutput.BaseStream, StagePath(launch.workspace, launch.index, "stdout.log"), profile.diagnostic_bytes_per_stream);
+        Task stderr = CopyBoundedAsync(process.StandardError.BaseStream, StagePath(launch.workspace, launch.index, "stderr.log"), profile.diagnostic_bytes_per_stream);
+        try { await process.WaitForExitAsync(cancelled.Token); result.exit_code = process.ExitCode; }
+        catch (OperationCanceledException) {
+            if (!process.HasExited) process.Kill(entireProcessTree: true);
+            await process.WaitForExitAsync(); result.exit_code = 124;
+        }
+        try { await Task.WhenAll(stdout, stderr).WaitAsync(TimeSpan.FromSeconds(5)); }
+        catch (TimeoutException) { result.exit_code = 125; }
+        result.stopped_at_utc = JsonTools.UtcNowString();
+        DurableFile.Write(StagePath(launch.workspace, launch.index, "result.json"), JsonTools.Serialize(result));
+        return result.exit_code;
+    }
+
+    internal static async Task CopyBoundedAsync(Stream input, string path, int maximum)
+    {
+        using var output = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.Read);
+        if (!OperatingSystem.IsWindows()) File.SetUnixFileMode(path, UnixFileMode.UserRead | UnixFileMode.UserWrite);
+        var buffer = new byte[65536]; int total = 0, count;
+        while ((count = await input.ReadAsync(buffer)) != 0) {
+            int keep = Math.Min(count, maximum - total);
+            if (keep > 0) { await output.WriteAsync(buffer.AsMemory(0, keep)); total += keep; }
+        }
+        output.Flush(true);
+    }
+}
