+        if (profile.approval!.dataset_sha256 != ScientificProfile.DatasetHash(manifest))
+            throw new InvalidOperationException("scientific_dataset_not_approved");
+        foreach (var pinned in new[] { profile.engine, profile.qc_criteria }.Concat(profile.tools).Concat(profile.references)) pinned.Verify(force: true);
+        var work = Workspace(config.WorkspacePath, start.job_id);
+        var journalPath = SafePath.Child(work, "execution.json");
+        ExecutionJournal journal;
+        if (File.Exists(journalPath)) {
+            journal = JsonTools.Deserialize<ExecutionJournal>(File.ReadAllText(journalPath)) ?? throw new ExecutionHeldException("scientific_journal_invalid");
+            RequireBinding(journal, start, profile, startedAt);
+        } else {
+            if (recovering || Directory.Exists(work)) throw new ExecutionHeldException("scientific_journal_missing");
+            Directory.CreateDirectory(work);
+            if (!OperatingSystem.IsWindows()) File.SetUnixFileMode(work, UnixFileMode.UserRead | UnixFileMode.UserWrite | UnixFileMode.UserExecute);
+            journal = new() { job_id = start.job_id, start_sha256 = JsonTools.CanonicalHash(JsonTools.Serialize(start)),
+                input_manifest_sha256 = start.input_manifest.sha256, profile_sha256 = profile.DefinitionHash(), started_at_utc = startedAt,
+                stages = profile.stages.Select(s => new StageCheckpoint { name = s.name, nonce = JsonTools.NewGuidString() }).ToList() };
+            Save();
+        }
+        if (journal.stages.Any(s => s.state == "InFlight")) throw new ExecutionHeldException("scientific_interrupted_stage_requires_reconciliation");
+        if (journal.failure_code is not null) throw new InvalidOperationException(journal.failure_code);
+        // Only a completely bound, verified publication can resume terminal reporting without computation.
+        if (journal.phase == "Published") {
+            if (journal.output_manifest is null || journal.stopped_at_utc is null) throw new ExecutionHeldException("scientific_publication_ambiguous");
+            await storage.VerifyObjectAsync(journal.output_manifest, ct);
+            return new(journal.output_manifest, journal.stopped_at_utc);
+        }
+        using var budget = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        var elapsed = DateTimeOffset.UtcNow - DateTimeOffset.Parse(startedAt, System.Globalization.CultureInfo.InvariantCulture);
+        if (elapsed.TotalSeconds >= profile.maximum_run_seconds && journal.stages.Any(s => s.state != "Complete"))
+            throw new InvalidOperationException("scientific_execution_budget_exceeded");
+        budget.CancelAfter(TimeSpan.FromSeconds(Math.Max(1, profile.maximum_run_seconds - elapsed.TotalSeconds)));
+        var runToken = budget.Token;
+        if (journal.phase == "Preparing") {
+            foreach (var folder in new[] { "inputs", "native", "scratch", "publication" }) Directory.CreateDirectory(SafePath.Child(work, folder));
+            var bindings = await MaterializeAsync(manifest, profile, work, runToken);
+            DurableFile.Write(SafePath.Child(work, "parameters.json"), JsonTools.Serialize(start.recipe.parameters));
+            DurableFile.Write(SafePath.Child(work, "bindings.json"), JsonTools.SerializeIndented(new {
+                job_id = start.job_id, manifest.scope, manifest.read_layout, input_manifest_sha256 = start.input_manifest.sha256,
+                parameters_sha256 = JsonTools.CanonicalHash(start.recipe.parameters), files = bindings,
+                references = profile.references, tools = profile.tools, profile_sha256 = profile.DefinitionHash()
+            }));
+            journal.phase = "Executing"; Save();
+        }
+        if (journal.phase == "Executing") {
