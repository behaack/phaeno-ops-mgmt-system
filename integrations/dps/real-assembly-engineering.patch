+++ b/apps/pseq_server/dps/src/DpsRecipeCatalog.cs
@@ -0,0 +1,247 @@
+using System.Security.Cryptography;
+using System.Text.Json;
+
+namespace Dps;
+
+// This is protected deployment configuration, never a user-supplied command or an approval UI.
+internal sealed class DpsRecipeCatalog
+{
+    public List<ScientificProfile> scientific_profiles = [];
+
+    internal static DpsRecipeCatalog Load(string? path)
+    {
+        if (string.IsNullOrWhiteSpace(path)) return new(); // Diagnostic simulation only.
+        if (new FileInfo(path).Length > 1_000_000) throw new InvalidOperationException("Recipe catalog exceeds its limit.");
+        var catalog = JsonTools.Deserialize<DpsRecipeCatalog>(File.ReadAllText(path))
+            ?? throw new InvalidOperationException("Recipe catalog is invalid.");
+        if (catalog.scientific_profiles.Count > 16) throw new InvalidOperationException("Too many scientific profiles.");
+        var identities = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var profile in catalog.scientific_profiles) {
+            if (profile.key == DpsContract.PSEQ_RECIPE_KEY || !identities.Add(profile.key + ":" + profile.version))
+                throw new InvalidOperationException("Reserved or duplicate recipe identity.");
+        }
+        return catalog;
+    }
+
+    internal ScientificProfile? Scientific(RECIPE_DTO recipe) => scientific_profiles.SingleOrDefault(p => p.key == recipe.key && p.version == recipe.version);
+
+    internal List<CAPABILITY_RECIPE_DTO> Available()
+    {
+        List<CAPABILITY_RECIPE_DTO> result = [Simulation()];
+        foreach (var profile in scientific_profiles) if (profile.ReadinessReason() is null) result.Add(profile.Capability());
+        return result;
+    }
+
+    internal static CAPABILITY_RECIPE_DTO Simulation() => new() {
+        key = DpsContract.PSEQ_RECIPE_KEY, name = DpsContract.PSEQ_RECIPE_NAME, version = DpsContract.PSEQ_RECIPE_VERSION,
+        parameters_schema = JsonSerializer.SerializeToElement(new { type = "object", additionalProperties = true }),
+        supported_read_layouts = ["PairedEnd"], required_output_roles = ["assembly_output", "provenance_report"]
+    };
+
+    internal string? Validate(RECIPE_DTO recipe)
+    {
+        if (SimulatedAssemblyRecipe.Matches(recipe.key, recipe.version)) return recipe.parameters.ValueKind == JsonValueKind.Object ? null : "recipe.parameters must be an object.";
+        var profile = Scientific(recipe);
+        if (profile is null) return "Recipe identity is not supported.";
+        var reason = profile.ReadinessReason();
+        if (reason is not null) return reason;
+        return JsonTools.CanonicalHash(recipe.parameters) == JsonTools.CanonicalHash(profile.parameters) ? null : "Scientific parameters do not match the approved profile.";
+    }
+}
+
+internal sealed class ScientificProfile
+{
+    public string key = "pseq_scientific_assembly";
+    public string name = "PSeq scientific assembly";
+    public string version = "0.1.0";
+    public string runtime_identifier = "linux-arm64";
+    public bool enabled; // Deliberately false in every shipped example.
+    public JsonElement parameters = JsonSerializer.SerializeToElement(new { });
+    public List<string> supported_read_layouts = ["PairedEnd"];
+    public PinnedFile engine = new();
+    public List<PinnedFile> tools = [];
+    public List<PinnedFile> references = [];
+    public PinnedFile qc_criteria = new();
+    public List<ScientificStage> stages = [];
+    public List<ScientificOutput> outputs = [];
+    public long maximum_input_bytes = 10L * 1024 * 1024 * 1024;
+    public long maximum_expanded_input_bytes = 40L * 1024 * 1024 * 1024;
+    public long maximum_output_file_bytes = 100L * 1024 * 1024;
+    public long maximum_output_set_bytes = 400_000_000;
+    public long minimum_free_disk_bytes = 1024L * 1024 * 1024;
+    public long maximum_workspace_bytes = 50L * 1024 * 1024 * 1024;
+    public int maximum_run_seconds = 86400;
+    public int diagnostic_bytes_per_stream = 1024 * 1024;
+    public ScientificApproval? approval;
+
+    internal string DefinitionHash() => JsonTools.CanonicalHash(JsonSerializer.SerializeToElement(new {
+        key, name, version, runtime_identifier, parameters, supported_read_layouts, engine, tools, references, qc_criteria, stages, outputs,
+        maximum_input_bytes, maximum_expanded_input_bytes, maximum_output_file_bytes, maximum_output_set_bytes,
+        minimum_free_disk_bytes, maximum_workspace_bytes, maximum_run_seconds, diagnostic_bytes_per_stream
+    }, JsonTools.Options));
+
+    internal string ReferencesHash() => JsonTools.CanonicalHash(JsonSerializer.SerializeToElement(references, JsonTools.Options));
+
+    internal void ValidateDefinition()
+    {
+        if (!DpsValidation.IsRoleName(key) || string.IsNullOrWhiteSpace(version) || version.Length > 100 || name.Length is < 1 or > 255
+            || runtime_identifier is not ("linux-arm64" or "linux-x64")
+            || parameters.ValueKind != JsonValueKind.Object || supported_read_layouts.Count == 0
+            || supported_read_layouts.Distinct().Count() != supported_read_layouts.Count
+            || supported_read_layouts.Any(x => x is not ("PairedEnd" or "SingleEnd"))
+            || maximum_input_bytes < 1 || maximum_expanded_input_bytes < maximum_input_bytes || minimum_free_disk_bytes < 0
+            || maximum_workspace_bytes < maximum_input_bytes || maximum_output_set_bytes > maximum_workspace_bytes - maximum_input_bytes
+            || maximum_output_file_bytes is < 1 or > 104857600 || maximum_output_set_bytes < maximum_output_file_bytes
+            || maximum_output_set_bytes > 400_000_000 || maximum_run_seconds is < 1 or > 604800
+            || diagnostic_bytes_per_stream is < 1024 or > 10485760 || tools.Count > 62 || references.Count is < 1 or > 64
+            || stages.Count is < 1 or > 32 || outputs.Count is < 1 or > 62
+            || stages.Select(s => s.name).Distinct(StringComparer.Ordinal).Count() != stages.Count
+            || outputs.Select(o => o.role).Distinct(StringComparer.Ordinal).Count() != outputs.Count
+            || outputs.Any(o => !DpsValidation.IsRoleName(o.role) || o.role == "provenance_report" || o.path == "provenance-report.json" || !SafePath.IsRelative(o.path)
+                || o.format is not ("FASTA" or "JSON" or "TSV" or "CSV" or "TEXT"))
+            || outputs.Select(o => o.path).Distinct(StringComparer.Ordinal).Count() != outputs.Count
+            || stages.Any(s => !DpsValidation.IsRoleName(s.name) || s.arguments.Count is < 1 or > 128
+                || s.arguments.Any(a => a.Length > 8192 || a.Contains('\0')
+                    || a.Replace("{bindings}", "").Replace("{parameters}", "").Replace("{workspace}", "").IndexOfAny(['{', '}']) >= 0)))
+            throw new InvalidOperationException("Scientific profile definition is invalid.");
+        foreach (var file in new[] { engine, qc_criteria }.Concat(tools).Concat(references)) file.ValidateDefinition();
+    }
+
+    internal string? ReadinessReason()
+    {
+        try {
+        if (!enabled || approval is null) return "Scientific recipe is held pending dataset, reference and scientific QC approval.";
+        if (!OperatingSystem.IsLinux() || System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier != runtime_identifier)
+            return "Scientific recipe requires its pinned Linux architecture.";
+        if (approval.profile_sha256 != DefinitionHash() || approval.references_sha256 != ReferencesHash()
+            || approval.qc_criteria_sha256 != qc_criteria.sha256 || !PinnedFile.IsHash(approval.dataset_sha256)
+            || !approval.dataset.IsValid() || !approval.references.IsValid() || !approval.scientific_qc.IsValid())
+            return "Scientific approvals do not bind the current profile, dataset, references and QC criteria.";
+            ValidateDefinition();
+            foreach (var file in new[] { engine, qc_criteria }.Concat(tools).Concat(references)) file.Verify();
+        } catch { return "Scientific pinned executable, tool, reference or QC preflight failed."; }
+        return null;
+    }
+
+    internal CAPABILITY_RECIPE_DTO Capability() => new() { key = key, name = name, version = version,
+        parameters_schema = JsonSerializer.SerializeToElement(new { type = "object", @const = parameters }),
+        supported_read_layouts = supported_read_layouts.ToList(), required_output_roles = outputs.Select(o => o.role).Append("provenance_report").ToList() };
+
+    // Excludes attempt/time/output prefix, so an explicitly linked repeat can use the same approved dataset.
+    internal static string DatasetHash(INPUT_MANIFEST_DTO manifest) => JsonTools.CanonicalHash(JsonSerializer.SerializeToElement(new {
+        manifest.scope, manifest.read_layout, manifest.recipe,
+        files = manifest.files.OrderBy(f => f.group_number).ThenBy(f => f.part_number).ThenBy(f => f.read_number).ThenBy(f => f.file_id, StringComparer.Ordinal)
+    }, JsonTools.Options));
+}
+
+internal sealed class ScientificApproval
+{
+    public string profile_sha256 = "";
+    public string dataset_sha256 = "";
+    public string references_sha256 = "";
+    public string qc_criteria_sha256 = "";
+    public ApprovalRecord dataset = new();
+    public ApprovalRecord references = new();
+    public ApprovalRecord scientific_qc = new();
+}
+
+internal sealed class ApprovalRecord
+{
+    public string approved_by = "";
+    public string approved_at_utc = "";
+    public string evidence_id = "";
+    internal bool IsValid() => !string.IsNullOrWhiteSpace(approved_by) && !string.IsNullOrWhiteSpace(evidence_id)
+        && approved_at_utc.EndsWith('Z') && DateTimeOffset.TryParse(approved_at_utc, out var at) && at <= DateTimeOffset.UtcNow;
+}
+
+internal sealed class PinnedFile
+{
+    public string name = "";
+    public string version = "";
+    public string path = "";
+    public string sha256 = "";
+    private string? verifiedIdentity;
+    internal static bool IsHash(string value) => value.Length == 64 && value.All(c => c is >= '0' and <= '9' or >= 'a' and <= 'f');
+    internal void ValidateDefinition()
+    {
+        if (name.Length is < 1 or > 255 || version.Length is < 1 or > 1000 || !Path.IsPathFullyQualified(path) || !IsHash(sha256))
+            throw new InvalidOperationException("Pinned file identity is invalid.");
+    }
+    internal void Verify(bool force = false)
+    {
+        ValidateDefinition();
+        SafePath.NoLinks(path);
+        if (!OperatingSystem.IsWindows() && (File.GetUnixFileMode(path) & (UnixFileMode.UserWrite | UnixFileMode.GroupWrite | UnixFileMode.OtherWrite)) != 0)
+            throw new InvalidOperationException("Pinned files must be read-only.");
+        var info = new FileInfo(path);
+        var identity = path + ":" + sha256 + ":" + info.Length + ":" + info.LastWriteTimeUtc.Ticks;
+        if (!force && identity == verifiedIdentity) return;
+        using var stream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read);
+        if (Convert.ToHexString(SHA256.HashData(stream)).ToLowerInvariant() != sha256) throw new InvalidOperationException("Pinned file changed.");
+        verifiedIdentity = identity;
+    }
+}
+
+internal sealed class ScientificStage
+{
+    public string name = "";
+    // No shell, PATH search, or user parameter interpolation. The approved engine reads the frozen JSON bindings.
+    public List<string> arguments = [];
+}
+
+internal sealed class ScientificOutput
+{
+    public string role = "";
+    public string path = ""; // Relative to this attempt's native/ directory.
+    public string format = "";
+}
+
+internal static class SafePath
+{
+    internal static bool IsRelative(string value) => !string.IsNullOrWhiteSpace(value) && !Path.IsPathRooted(value)
+        && !value.Contains('\\') && !value.Contains(':') && !value.Any(char.IsControl)
+        && value.Split('/').All(p => p.Length > 0 && p is not ("." or ".."));
+
+    internal static string Child(string root, string relative)
+    {
+        if (!IsRelative(relative)) throw new InvalidOperationException("Unsafe workspace path.");
+        var full = Path.GetFullPath(Path.Combine(root, relative));
+        NoLinks(root);
+        NoLinks(full);
+        return full;
+    }
+
+    internal static void NoLinks(string path)
+    {
+        for (string? part = Path.GetFullPath(path); !string.IsNullOrEmpty(part); part = Path.GetDirectoryName(part)) {
+            try {
+                if ((File.GetAttributes(part) & FileAttributes.ReparsePoint) != 0)
+                    throw new InvalidOperationException("Links are forbidden in protected execution paths.");
+            } catch (FileNotFoundException) { } catch (DirectoryNotFoundException) { }
+        }
+    }
+}
+
+internal static class DurableFile
+{
+    [System.Runtime.InteropServices.DllImport("libc", SetLastError = true)] private static extern int open(string path, int flags);
+    [System.Runtime.InteropServices.DllImport("libc", SetLastError = true)] private static extern int fsync(int descriptor);
+    [System.Runtime.InteropServices.DllImport("libc")] private static extern int close(int descriptor);
+    internal static void Write(string path, string content)
+    {
+        SafePath.NoLinks(path);
+        var temp = path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        using (var stream = new FileStream(temp, FileMode.CreateNew, FileAccess.Write, FileShare.None, 65536, FileOptions.WriteThrough)) {
+            if (!OperatingSystem.IsWindows()) File.SetUnixFileMode(temp, UnixFileMode.UserRead | UnixFileMode.UserWrite);
+            using var writer = new StreamWriter(stream, new System.Text.UTF8Encoding(false), leaveOpen: true);
+            writer.Write(content); writer.Flush(); stream.Flush(true);
+        }
+        File.Move(temp, path, true);
+        if (OperatingSystem.IsLinux()) {
+            int directory = open(Path.GetDirectoryName(Path.GetFullPath(path))!, 65536); // O_DIRECTORY | O_RDONLY
+            if (directory < 0) throw new IOException("Could not sync journal directory.");
+            try { if (fsync(directory) != 0) throw new IOException("Could not sync journal directory."); }
+            finally { close(directory); }
+        }
+    }
+}
