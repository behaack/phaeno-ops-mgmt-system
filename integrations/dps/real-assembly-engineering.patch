-    internal async Task CallPhaenoRunner(
-        uint startPercent,
-        uint endPercent,
-        CancellationToken cancellationToken,
-        params string[] arguments)
-    {
-        cancellationToken.ThrowIfCancellationRequested();
-        if (endPercent <= startPercent)
-        {
-            throw new ArgumentOutOfRangeException(nameof(endPercent));
-        }
-
-        string ? runnerFolder = Util.ReadNullableEV("PB_RUNNER");
-        if (string.IsNullOrWhiteSpace(runnerFolder))
-        {
-            throw new InvalidOperationException("PB_RUNNER must specify the Phaeno-Runner folder.");
-        }
-
-        string executable = Path.Combine(runnerFolder, OperatingSystem.IsWindows() ? "phaeno.exe" : "phaeno");
-        if (File.Exists(executable) == false)
-        {
-            throw new FileNotFoundException($"Phaeno-Runner executable '{executable}' was not found.", executable);
-        }
-
-        ProcessStartInfo startInfo = new(executable)
-        {
-            UseShellExecute = false,
-            RedirectStandardOutput = true,
-            RedirectStandardError = true,
-            CreateNoWindow = true
-        };
-        foreach (string argument in arguments)
-        {
-            startInfo.ArgumentList.Add(argument);
-        }
-
-        using Process process = new() { StartInfo = startInfo };
-        process.Start();
-        Task<string> standardOutput = process.StandardOutput.ReadToEndAsync();
-        Task<string> standardError  = process.StandardError.ReadToEndAsync();
-
-        try
-        {
-            double percent = startPercent;
-            await PublishProgress(percent);
-
-            Task exited = process.WaitForExitAsync(cancellationToken);
-            using PeriodicTimer timer = new(TimeSpan.FromSeconds(5));
-            while (exited.IsCompleted == false)
-            {
-                Task<bool> tick = timer.WaitForNextTickAsync(cancellationToken).AsTask();
-                await Task.WhenAny(exited, tick);
-                if (exited.IsCompleted)
-                {
-                    break;
-                }
-
-                await tick;
-                cancellationToken.ThrowIfCancellationRequested();
-                percent = Math.Min(percent + 1, endPercent - 1);
-                await PublishProgress(percent);
-            }
-
-            await exited;
-        }
-        finally
-        {
-            if (process.HasExited == false)
-            {
-                try
-                {
-                    process.Kill(entireProcessTree: true);
-                }
-                catch (InvalidOperationException) when (process.HasExited)
-                {
-                }
-            }
-
-            await process.WaitForExitAsync();
-            await Task.WhenAll(standardOutput, standardError);
-            RunnerOutput.Add((await standardOutput, await standardError));
-        }
-
-        cancellationToken.ThrowIfCancellationRequested();
-        if (process.ExitCode != 0)
-        {
-            throw new InvalidOperationException(
-                $"Phaeno-Runner exited with code {process.ExitCode}.{Environment.NewLine}" +
-                $"{await standardOutput}{Environment.NewLine}{await standardError}");
-        }
-
-        await PublishProgress(endPercent);
-    }
-
