+set -eu
+# systemd supplies these values even when the worker dies before it can log its own exit.
+printf 'DPS service exit: code=%s status=%s result=%s\n' "${EXIT_CODE:-unknown}" "${EXIT_STATUS:-unknown}" "${SERVICE_RESULT:-unknown}"
+if test -f /home/ubuntu/.phaeno/DPS/current/build-receipt.json; then
+    cat /home/ubuntu/.phaeno/DPS/current/build-receipt.json
+fi
