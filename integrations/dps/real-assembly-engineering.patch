+        DurableFile.Write(manifestPath, journal.output_manifest_json);
+        if (journal.output_manifest is null) {
+            if (journal.manifest_upload_state != "Pending") throw new ExecutionHeldException("scientific_manifest_receipt_missing");
+            journal.manifest_upload_state = "Uploading"; Save();
+            journal.output_manifest = await storage.PutFileAndVerifyAsync(manifest.output_destination.bucket, manifest.output_destination.region,
+                DpsValidation.TryParseS3Uri(start.data_folder, out var destination) ? destination!.Prefix + "output-manifest.json" : throw new InvalidOperationException(),
+                manifestPath, "application/json", ct, address => { journal.output_manifest = address; Save(); });
+        } else await storage.VerifyObjectAsync(journal.output_manifest, ct);
+        journal.manifest_upload_state = "Verified"; journal.phase = "Published"; Save();
+        return new(journal.output_manifest, journal.stopped_at_utc!);
+
+        void Save() => DurableFile.Write(journalPath, JsonTools.SerializeIndented(journal));
+    }
+
+    internal static string Workspace(string root, string jobId)
+    {
+        if (!Guid.TryParseExact(jobId, "D", out var id) || id.ToString("D") != jobId) throw new InvalidOperationException("Invalid attempt identity.");
+        return SafePath.Child(Path.GetFullPath(root), jobId);
+    }
+
+    internal static void RequireRecoverable(string root, string jobId)
+    {
+        var path = SafePath.Child(Workspace(root, jobId), "execution.json");
+        if (!File.Exists(path)) throw new ExecutionHeldException("scientific_journal_missing");
+        var journal = JsonTools.Deserialize<ExecutionJournal>(File.ReadAllText(path));
+        if (journal is null || journal.job_id != jobId || journal.version != 1 || journal.stages.Any(s => s.state == "InFlight"))
+            throw new ExecutionHeldException("scientific_interrupted_stage_requires_reconciliation");
+    }
+
+    internal static bool RequiresHold(string root, string jobId)
+    {
+        try {
+            var path = SafePath.Child(Workspace(root, jobId), "execution.json");
+            if (!File.Exists(path)) return Directory.Exists(Workspace(root, jobId));
+            var journal = JsonTools.Deserialize<ExecutionJournal>(File.ReadAllText(path));
+            return journal is null || journal.stages.Any(s => s.state == "InFlight") || journal.phase is "Collecting" or "Publishing" or "Published";
+        } catch { return true; }
+    }
+
+    internal static string? RecordedStop(string root, string jobId)
+    {
+        var path = SafePath.Child(Workspace(root, jobId), "execution.json");
+        return File.Exists(path) ? JsonTools.Deserialize<ExecutionJournal>(File.ReadAllText(path))?.stopped_at_utc : null;
+    }
+
+    internal static void RequireBinding(ExecutionJournal journal, START_COMMAND_DTO start, ScientificProfile profile, string startedAt)
+    {
+        if (journal.version != 1 || journal.job_id != start.job_id || journal.start_sha256 != JsonTools.CanonicalHash(JsonTools.Serialize(start))
+            || journal.input_manifest_sha256 != start.input_manifest.sha256 || journal.profile_sha256 != profile.DefinitionHash()
+            || journal.started_at_utc != startedAt || !journal.stages.Select(s => s.name).SequenceEqual(profile.stages.Select(s => s.name)))
+            throw new ExecutionHeldException("scientific_journal_binding_mismatch");
+    }
+
+    private async Task<List<object>> MaterializeAsync(INPUT_MANIFEST_DTO manifest, ScientificProfile profile, string work, CancellationToken ct)
+    {
+        long compressed = 0, expanded = 0;
+        foreach (var file in manifest.files) {
+            if (file.s3.size_bytes < 1 || file.s3.size_bytes > profile.maximum_input_bytes - compressed) throw new InvalidOperationException("scientific_input_budget_exceeded");
+            compressed += file.s3.size_bytes;
+        }
+        if (new DriveInfo(Path.GetPathRoot(work)!).AvailableFreeSpace < profile.minimum_free_disk_bytes + profile.maximum_output_set_bytes + compressed)
+            throw new InvalidOperationException("scientific_scratch_budget_unavailable");
+        var bindings = new List<object>();
+        var pairedHeaders = new Dictionary<(int, int), string>();
+        foreach (var file in manifest.files.OrderBy(f => f.group_number).ThenBy(f => f.part_number).ThenBy(f => f.read_number)) {
+            var relative = "inputs/" + file.file_id + (file.compression == "gzip" ? ".fastq.gz" : ".fastq");
+            var path = SafePath.Child(work, relative);
+            if (File.Exists(path)) await RequireLocalAsync(path, file.s3.sha256, file.s3.size_bytes, ct);
+            else await storage.MaterializeAsync(file.s3, path, profile.maximum_input_bytes, ct);
+            var checkedFile = await ValidateFastqAsync(path, file.compression, file.read_count, profile.maximum_expanded_input_bytes - expanded, ct);
+            expanded += checkedFile.Size;
+            if (manifest.read_layout == "PairedEnd") {
+                var key = (file.group_number, file.part_number);
+                if (pairedHeaders.TryGetValue(key, out var headers) && headers != checkedFile.HeadersHash) throw new InvalidOperationException("scientific_paired_headers_mismatch");
+                pairedHeaders[key] = checkedFile.HeadersHash;
+            }
+            bindings.Add(new { source = file, local_path = path, expanded_size_bytes = checkedFile.Size, read_identifiers_sha256 = checkedFile.HeadersHash });
+        }
+        foreach (var pair in manifest.files.GroupBy(f => (f.group_number, f.part_number)))
+            if (manifest.read_layout == "PairedEnd" && (pair.Count() != 2 || pair.Select(f => f.read_count).Distinct().Count() != 1))
+                throw new InvalidOperationException("scientific_paired_read_count_mismatch");
+        foreach (var parts in manifest.files.GroupBy(f => (f.group_number, f.read_number)))
+            if (!parts.Select(f => f.part_number).Order().SequenceEqual(Enumerable.Range(1, parts.Count())))
+                throw new InvalidOperationException("scientific_part_sequence_incomplete");
+        return bindings;
+    }
+
+    internal static async Task<long> FastqAsync(string path, string compression, long expectedReads, long maximum, CancellationToken ct)
+        => (await ValidateFastqAsync(path, compression, expectedReads, maximum, ct)).Size;
+
+    private static async Task<(long Size, string HeadersHash)> ValidateFastqAsync(string path, string compression, long expectedReads, long maximum, CancellationToken ct)
+    {
+        await using var file = File.OpenRead(path);
+        await using Stream source = compression == "gzip" ? new GZipStream(file, CompressionMode.Decompress, leaveOpen: true) : file;
+        await using var bounded = new BoundedReadStream(source, maximum);
+        using var reader = new BoundedLineReader(new StreamReader(bounded, new UTF8Encoding(false, true), detectEncodingFromByteOrderMarks: false, bufferSize: 65536));
+        using var headers = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
+        long count = 0;
+        while (await reader.ReadLineAsync(ct) is { } header) {
+            var sequence = await reader.ReadLineAsync(ct); var plus = await reader.ReadLineAsync(ct); var quality = await reader.ReadLineAsync(ct);
+            if (!header.StartsWith('@') || sequence is null || sequence.Length == 0 || plus is null || !plus.StartsWith('+') || quality is null
+                || quality.Length != sequence.Length || sequence.Any(c => "ACGTUNacgtun".IndexOf(c) < 0) || quality.Any(c => c is < '!' or > '~'))
+                throw new InvalidOperationException("scientific_fastq_invalid");
+            if (++count > expectedReads) throw new InvalidOperationException("scientific_read_count_mismatch");
+            var identity = header.Split(' ', '\t')[0];
+            if (identity.EndsWith("/1", StringComparison.Ordinal) || identity.EndsWith("/2", StringComparison.Ordinal)) identity = identity[..^2];
+            headers.AppendData(Encoding.UTF8.GetBytes(identity + "\n"));
+        }
+        if (count != expectedReads) throw new InvalidOperationException("scientific_read_count_mismatch");
+        return (bounded.Total, Convert.ToHexString(headers.GetHashAndReset()).ToLowerInvariant());
+    }
+
+    private static async Task<List<PublishedArtifact>> CollectAsync(ScientificProfile profile, START_COMMAND_DTO start, INPUT_MANIFEST_DTO manifest,
+        string work, ExecutionJournal journal, CancellationToken ct)
+    {
+        long retained = 0;
+        foreach (var file in Directory.EnumerateFiles(work, "*", new EnumerationOptions { RecurseSubdirectories = true, AttributesToSkip = FileAttributes.ReparsePoint })) {
+            long size = new FileInfo(file).Length;
+            if (size > profile.maximum_workspace_bytes - retained) throw new InvalidOperationException("scientific_publication_workspace_budget_exceeded");
+            retained += size;
+        }
+        if (profile.maximum_output_set_bytes > profile.maximum_workspace_bytes - retained
+            || new DriveInfo(Path.GetPathRoot(work)!).AvailableFreeSpace < profile.minimum_free_disk_bytes + profile.maximum_output_set_bytes)
+            throw new InvalidOperationException("scientific_publication_workspace_budget_exceeded");
+        var report = SafePath.Child(work, "native/provenance-report.json");
+        var reportBytes = Encoding.UTF8.GetBytes(journal.provenance_report_json!);
+        if (File.Exists(report)) await RequireLocalAsync(report, JsonTools.Sha256Hex(reportBytes), reportBytes.Length, ct);
+        else DurableFile.Write(report, journal.provenance_report_json!);
+        var result = new List<PublishedArtifact>(); long total = 0;
+        foreach (var output in profile.outputs.Append(new ScientificOutput { role = "provenance_report", path = "provenance-report.json", format = "JSON" })) {
+            var source = SafePath.Child(SafePath.Child(work, "native"), output.path);
+            var size = new FileInfo(source).Length;
+            if (size < 1 || size > profile.maximum_output_file_bytes || size > profile.maximum_output_set_bytes - total)
+                throw new InvalidOperationException("scientific_output_budget_exceeded");
+            await ValidateOutputAsync(source, output.format, ct); total += size;
+            var id = JsonTools.NewGuidString();
+            var extension = output.format switch { "FASTA" => ".fasta", "JSON" => ".json", "TSV" => ".tsv", "CSV" => ".csv", _ => ".txt" };
+            var relative = "publication/" + id + extension;
+            var target = SafePath.Child(work, relative);
+            using (var input = File.OpenRead(source))
+            using (var copy = new FileStream(target, FileMode.CreateNew, FileAccess.Write, FileShare.None)) { await input.CopyToAsync(copy, ct); copy.Flush(true); }
+            if (!OperatingSystem.IsWindows()) File.SetUnixFileMode(target, UnixFileMode.UserRead);
+            using var hashInput = File.OpenRead(target);
+            var hash = Convert.ToHexString(await SHA256.HashDataAsync(hashInput, ct)).ToLowerInvariant();
+            result.Add(new() { path = relative, sha256 = hash, size_bytes = size,
+                artifact = new() { artifact_id = id, role = output.role, format = output.format, file_name = output.role + extension } });
+        }
+        return result;
+    }
+
+    internal static async Task ValidateOutputAsync(string path, string format, CancellationToken ct)
+    {
+        if (format == "JSON") {
+            await using var json = File.OpenRead(path); using var document = await JsonDocument.ParseAsync(json, new() { MaxDepth = 48 }, ct);
+            RejectDiagnostic(document.RootElement); return;
+        }
+        using var reader = new BoundedLineReader(new StreamReader(path, new UTF8Encoding(false, true)));
+        bool header = false, bases = false, anyInformativeBase = false; int columns = 0, lines = 0;
+        while (await reader.ReadLineAsync(ct) is { } line) {
+            lines++;
+            if (line.Contains("SIMULATED", StringComparison.OrdinalIgnoreCase) || line.Contains("placeholder", StringComparison.OrdinalIgnoreCase) || line.Any(c => char.IsControl(c) && c != '\t'))
+                throw new InvalidOperationException("scientific_placeholder_or_invalid_text");
+            if (format == "FASTA") {
+                if (line.StartsWith('>')) { if (header && !bases || line.Length < 2) throw new InvalidOperationException("scientific_fasta_invalid"); header = true; bases = false; }
+                else { if (!header || line.Length == 0 || line.Any(c => "ACGTURYSWKMBDHVNacgturyswkmbdhvn".IndexOf(c) < 0)) throw new InvalidOperationException("scientific_fasta_invalid"); bases = true; anyInformativeBase |= line.Any(c => "ACGTUacgtu".Contains(c)); }
+            } else if (format is "TSV" or "CSV") {
+                // CSV is deliberately limited to unquoted records; a qualified quoted CSV parser needs explicit scope.
+                if (format == "CSV" && line.Contains('"')) throw new InvalidOperationException("scientific_csv_quoted_format_not_qualified");
+                int count = line.Split(format == "TSV" ? '\t' : ',').Length;
+                if (count < 2 || columns != 0 && columns != count) throw new InvalidOperationException("scientific_table_invalid"); columns = count;
+            }
+        }
+        if (lines == 0 || format == "FASTA" && (!header || !bases || !anyInformativeBase)) throw new InvalidOperationException("scientific_output_incomplete");
+    }
+
+    private static void RejectDiagnostic(JsonElement value)
+    {
+        if (value.ValueKind == JsonValueKind.Object) foreach (var property in value.EnumerateObject()) {
+            if (property.Name == "simulated" && property.Value.ValueKind == JsonValueKind.True
+                || property.Name == "scientific_use" && property.Value.ValueKind == JsonValueKind.False)
+                throw new InvalidOperationException("scientific_diagnostic_output_rejected");
+            RejectDiagnostic(property.Value);
+        }
+        else if (value.ValueKind == JsonValueKind.Array) foreach (var item in value.EnumerateArray()) RejectDiagnostic(item);
+        else if (value.ValueKind == JsonValueKind.String && value.GetString()!.Contains("_placeholder", StringComparison.OrdinalIgnoreCase))
+            throw new InvalidOperationException("scientific_diagnostic_output_rejected");
+    }
+
+    internal static PROVENANCE_DTO Provenance(ScientificProfile profile) => new() {
+        engine = profile.engine.name, engine_version = profile.engine.version,
+        tools = profile.tools.Prepend(profile.engine).Select(t => new PROVENANCE_TOOL_DTO { name = t.name, version = t.version }).ToList(),
+        reference_data = profile.references.Select(r => new REFERENCE_DATA_DTO { name = r.name, version = r.version, sha256 = r.sha256 }).ToList()
+    };
+
+    internal static async Task RequireLocalAsync(string path, string hash, long size, CancellationToken ct)
+    {
+        SafePath.NoLinks(path); using var input = File.OpenRead(path);
+        if (input.Length != size || Convert.ToHexString(await SHA256.HashDataAsync(input, ct)).ToLowerInvariant() != hash)
+            throw new ExecutionHeldException("scientific_local_bytes_changed");
+    }
+
+    private static string ContentType(string format) => format == "JSON" ? "application/json" : "text/plain";
+}
+
+// Bound a malformed line while reading buffered chunks, before allocating an unbounded string.
+internal sealed class BoundedLineReader(StreamReader reader) : IDisposable
+{
+    private readonly char[] buffer = new char[8192];
+    private int position, count;
+    internal async Task<string?> ReadLineAsync(CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested();
+        var line = new StringBuilder();
+        while (true) {
+            if (position == count) { count = await reader.ReadAsync(buffer.AsMemory(), ct); position = 0; }
+            if (count == 0) return line.Length == 0 ? null : line.ToString().TrimEnd('\r');
+            int end = Array.IndexOf(buffer, '\n', position, count - position);
+            int take = (end < 0 ? count : end) - position;
+            if (line.Length + take > 1_000_000) throw new InvalidOperationException("scientific_line_limit_exceeded");
+            line.Append(buffer, position, take); position += take;
+            if (end >= 0) { position++; return line.ToString().TrimEnd('\r'); }
+        }
+    }
+    public void Dispose() => reader.Dispose();
+}
+
+internal sealed class BoundedReadStream(Stream inner, long maximum) : Stream
+{
+    internal long Total { get; private set; }
+    public override async ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken ct = default) {
+        int count = await inner.ReadAsync(buffer[..(int)Math.Min(buffer.Length, Math.Max(1, maximum - Total + 1))], ct);
+        Total += count; if (Total > maximum) throw new InvalidOperationException("scientific_expansion_budget_exceeded"); return count;
+    }
+    public override int Read(byte[] buffer, int offset, int count) => throw new NotSupportedException();
+    public override bool CanRead => true; public override bool CanSeek => false; public override bool CanWrite => false;
+    public override long Length => throw new NotSupportedException(); public override long Position { get => Total; set => throw new NotSupportedException(); }
+    public override void Flush() => throw new NotSupportedException(); public override long Seek(long offset, SeekOrigin origin) => throw new NotSupportedException();
+    public override void SetLength(long length) => throw new NotSupportedException(); public override void Write(byte[] buffer, int offset, int count) => throw new NotSupportedException();
+}
