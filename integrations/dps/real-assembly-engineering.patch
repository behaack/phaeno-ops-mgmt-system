+using Dps;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using System.Net;
+using System.Text;
+using System.Text.Json;
+
+namespace DpsTest.UnitTests;
+
+[TestClass]
+public sealed class ScientificExecutionTests
+{
+    [TestMethod]
+    public async Task MaterializationUsesPinnedVersionAndNeverPromotesWrongBytes()
+    {
+        using var fixture = new NativeFixture(false);
+        var source = fixture.Manifest.files[0].s3; var path = Path.Combine(fixture.Root, "materialized.fastq");
+        await fixture.Storage.MaterializeAsync(source, path, 1024, default);
+        Assert.AreEqual("@read\nACGT\n+\nIIII\n", await File.ReadAllTextAsync(path));
+        StringAssert.Contains(fixture.Objects.LastQuery!, "versionId=v1");
+        File.Delete(path); fixture.Objects.CorruptGet = true;
+        await Assert.ThrowsExceptionAsync<InvalidOperationException>(() => fixture.Storage.MaterializeAsync(source, path, 1024, default));
+        Assert.IsFalse(File.Exists(path)); Assert.AreEqual(0, Directory.GetFiles(fixture.Root, "*.part").Length);
+    }
+
+    [TestMethod]
+    public async Task FileUploadPersistsVersionBeforeVerificationAndUsesCreateOnlyStreamingContent()
+    {
+        using var fixture = new NativeFixture(false);
+        var path = Path.Combine(fixture.Root, "large.txt"); await File.WriteAllTextAsync(path, new string('A', 200_000));
+        S3_OBJECT_DTO? saved = null; fixture.Objects.CorruptGet = true;
+        await Assert.ThrowsExceptionAsync<InvalidOperationException>(() => fixture.Storage.PutFileAndVerifyAsync("fixture-bucket", "us-east-2", "attempt/large", path,
+            "text/plain", default, address => saved = address));
+        Assert.IsNotNull(saved); Assert.AreEqual("v1", saved.version_id); Assert.AreEqual(200_000L, saved.size_bytes);
+        Assert.IsTrue(fixture.Objects.CreateOnly); Assert.IsTrue(fixture.Objects.Streamed);
+        fixture.Objects.CorruptGet = false; await fixture.Storage.VerifyObjectAsync(saved, default);
+        Assert.AreEqual(1, fixture.Objects.PutCount);
+    }
+
+    [TestMethod]
