+                if (result.exit_code != 0) {
+                    stage.state = "Failed"; journal.stopped_at_utc = result.fenced_at_utc!; journal.failure_code = "scientific_native_stage_failed"; Save();
+                    throw new InvalidOperationException(journal.failure_code);
+                }
+                stage.state = "Complete"; Save();
+                await progress(10 + 70.0 * (i + 1) / journal.stages.Count);
+            }
