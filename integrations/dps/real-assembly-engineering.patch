+internal sealed class ScientificExecution(DpsConfig config, S3StorageClient storage, Func<double, Task> progress)
+{
+    internal async Task<ScientificCompletion> ExecuteAsync(START_COMMAND_DTO start, INPUT_MANIFEST_DTO manifest,
+        string startedAt, bool recovering, CancellationToken ct)
+    {
+        var profile = config.Recipes.Scientific(start.recipe) ?? throw new ExecutionHeldException("scientific_profile_missing");
+        if (profile.ReadinessReason() is not null) throw new ExecutionHeldException("scientific_approval_or_preflight_hold");
+        if (JsonTools.CanonicalHash(start.recipe.parameters) != JsonTools.CanonicalHash(profile.parameters)
+            || !start.recipe.required_output_roles.SequenceEqual(profile.Capability().required_output_roles))
