---
import { getMessages } from '@/i18n/messages'
import type { SupportedLocale } from '@/i18n/locales'

interface Props {
  locale?: SupportedLocale
}

const { locale = 'en-US' } = Astro.props as Props
const pageMessages = getMessages(locale)
---

<button         
  id="burger-button" 
  class="burger"
  aria-label={pageMessages.toggleMenu}
  aria-haspopup="true"
  aria-controls="nav"
  aria-expanded="false"    
>
  <span class="sr-only">{pageMessages.mainMenu}</span>
  <span class="line top"></span>
  <span class="line middle"></span>
  <span class="line bottom"></span>
</button>

<style>
.burger {
  display: none;
  position: relative;
  background: var(--color-surface);
  color: var(--menu-color);
  border: none;
  width: 2.75rem;
  height: 2.75rem;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
  border: 1px solid var(--phaeno-green-200);
  border-radius: var(--radius-pill);
  cursor: pointer;
  z-index: 10;
  transition:
    background-color var(--duration-base) var(--ease-standard),
    border-color var(--duration-base) var(--ease-standard),
    transform var(--duration-fast) var(--ease-standard);
}

.burger:focus {
  color: var(--menu-focus-color);
  background-color: var(--menu-focus-bgcolor);
  outline: 1px solid var(--focus-ring-color);
  outline-offset: 3px;
  border-radius: var(--radius-pill);
}

.burger:hover,
.burger:focus:hover {
  color: var(--menu-hover-color);
  background-color: var(--phaeno-green-100);
}

.line {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 21px;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
  transform-origin: center;
  transition:
    transform var(--duration-fast) var(--ease-standard),
    opacity var(--duration-fast) var(--ease-standard);
}

.line.top {
  transform: translate(-50%, -50%) translateY(-7px);
}

.line.middle {
  transform: translate(-50%, -50%);
}

.line.bottom {
  transform: translate(-50%, -50%) translateY(7px);
}

.burger.open .top {
  transform: translate(-50%, -50%) rotate(45deg);
}

.burger.open .middle {
  opacity: 0;
}

.burger.open .bottom {
  transform: translate(-50%, -50%) rotate(-45deg);
}

@media (max-width: 900px) {
  .burger {
    display: flex;
  }
}
</style>
