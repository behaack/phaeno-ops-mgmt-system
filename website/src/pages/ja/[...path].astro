---
import LocalizedPageRenderer from '@/components/i18n/LocalizedPageRenderer.astro'
import { getLocalizedWhitePaper } from '@/i18n/localizedPublications'
import { isJapaneseEnabled } from '@/i18n/locales'
import { getStaticLocalizedRoutePath, localizedRoutePairs } from '@/i18n/routes'

export function getStaticPaths() {
  if (!isJapaneseEnabled) return []

  return localizedRoutePairs.map((route) => ({
    params: { path: getStaticLocalizedRoutePath(route.ja, 'ja') },
    props: {
      route,
      page: getLocalizedWhitePaper('ja', route.translationKey),
    },
  }))
}

const { route, page } = Astro.props
---

<LocalizedPageRenderer locale="ja" translationKey={route.translationKey} page={page} />
