---
import LocalizedPageRenderer from '@/components/i18n/LocalizedPageRenderer.astro'
import { getLocalizedWhitePaper } from '@/i18n/localizedPublications'
import { isItalianEnabled } from '@/i18n/locales'
import { getStaticLocalizedRoutePath, localizedRoutePairs } from '@/i18n/routes'

export function getStaticPaths() {
  if (!isItalianEnabled) return []

  return localizedRoutePairs.map((route) => ({
    params: { path: getStaticLocalizedRoutePath(route.it, 'it') },
    props: {
      route,
      page: getLocalizedWhitePaper('it', route.translationKey),
    },
  }))
}

const { route, page } = Astro.props
---

<LocalizedPageRenderer locale="it" translationKey={route.translationKey} page={page} />
