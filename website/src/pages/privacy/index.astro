---
import { Content } from '@/content/privacy.md';
import { Content as ArabicContent } from '@/content/privacy.ar.md';
import Layout from '@/layouts/Layout.astro';
import TopPageBanner from '@/components/TopPageBanner.astro';
import SEOMeta from '@/components/meta-data-helpers/SEOMeta.astro';
import TranslationReviewNotice from '@/components/i18n/TranslationReviewNotice.astro';
import type { SupportedLocale } from '@/i18n/locales';
import { getPageCatalog } from '@/i18n/pageCatalogs';
interface Props { locale?: SupportedLocale }
const { locale = 'en-US' } = Astro.props
const isTranslation = locale !== 'en-US'
const content = getPageCatalog(locale).privacy
---
<Layout locale={locale}>
  <SEOMeta 
    slot="head"
    title={content.metaTitle}
    description={content.description}
    documentType="Web Page"
    searchTitle={content.searchTitle}
    locale={locale}
  />    
  <main id="main">
    {isTranslation ? <TranslationReviewNotice englishPath="/privacy" /> : null}
    <TopPageBanner title={content.banner} image="image-1" locale={locale}/>
    <section>
      {isTranslation ? <ArabicContent /> : <Content />}
    </section>
  </main>
</Layout>
