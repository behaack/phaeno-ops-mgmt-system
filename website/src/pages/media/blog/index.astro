---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import MediaCard from '@/components/MediaCard.astro'
import MediaCollection from '@/components/MediaCollection.astro'
import RSSFeed from '@/components/RSSFeed.astro'
import TopPageBanner from '@/components/TopPageBanner.astro'
import SEOMeta from '@/components/meta-data-helpers/SEOMeta.astro'
import MediaSearch from '@/components/MediaSearch.astro'
import { BLOG_FEED_PATH, getBlogPostPath } from '@/lib/blogRoutes'
import { formatContentDate } from '@/lib/dates'

const blog = await getCollection('blog')
---

<title>Blog | Phaeno</title>
<meta name="description" content="Stay up to date with the latest news, breakthroughs, and company updates from the team at Phaeno." />

<Layout>
  <SEOMeta 
    slot="head"
    title="Our Blog | Phaeno"
    description="Learn about Phaeno's mission to transform molecular diagnostics through innovative RNA sequencing technology and expert leadership."
    documentType="List"
    searchTitle="Blog"
  />  
  <main id="main">
    <TopPageBanner title="Phaeno Blog"  image="image-1"/>
    <section>
    {blog.length ? (
      <div class="mb-2 flex justify-end">
        <RSSFeed feedName={BLOG_FEED_PATH}/>
      </div>) : null
    }
    <MediaSearch listLength={blog.length} placeholder="Search title or author" />
    <MediaCollection>
      {blog.map(paper => (
        <MediaCard
          searchString={`${paper.data.title} ${paper.data.authors.join(' ')}`.toLowerCase()}        
          title={paper.data.title} 
          image={paper.data.image} 
          summary={paper.data.summary}
          link={getBlogPostPath(paper.id)}
        >
          <div>{paper.data.authors.join(', ')}</div>
          <div>{formatContentDate(paper.data.date)}</div>
        </MediaCard>
      ))}      
    </MediaCollection>  
    {blog.length === 0 && (
      <div class="blog-empty">
        <h2>Explore the science behind PSeq</h2>
        <p>Our first blog articles are on the way. Read our technical white papers or sign up for Phaeno updates.</p>
        <div class="blog-empty__actions">
          <a href="/media/white-papers">Browse white papers <span aria-hidden="true">→</span></a>
          <a href="/contact#sign-up">Get Phaeno updates <span aria-hidden="true">→</span></a>
        </div>
      </div>
    )}
    </section>
  </main>
</Layout>

<style>
.blog-empty {
  max-width: var(--copy-max-width);
  padding-block: var(--space-6);
}

.blog-empty h2 {
  padding-top: 0;
}

.blog-empty p {
  color: var(--color-text-muted);
}

.blog-empty__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-top: var(--space-5);
}

.blog-empty__actions a {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  min-height: 2.75rem;
  padding: .7rem 1rem;
  border: 1px solid var(--color-brand-strong);
  border-radius: var(--radius-pill);
  color: var(--color-brand-strong);
  background: var(--color-surface-brand);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
}

.blog-empty__actions a:hover {
  background: var(--phaeno-green-100);
}
</style>
