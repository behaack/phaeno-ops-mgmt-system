---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import MediaCard from '@/components/MediaCard.astro'
import MediaCollection from '@/components/MediaCollection.astro'
import RSSFeed from '@/components/RSSFeed.astro'
import TopPageBanner from '@/components/TopPageBanner.astro'
import SEOMeta from '@/components/meta-data-helpers/SEOMeta.astro'
import MediaSearch from '@/components/MediaSearch.astro'
import MediaNoItems from '@/components/MediaNoItems.astro'
import { BLOG_FEED_PATH, getBlogPostPath } from '@/lib/blogRoutes'
import { formatContentDate } from '@/lib/dates'
import { prefixPathForLocale, type SupportedLocale } from '@/i18n/locales'
import { getPageCatalog } from '@/i18n/pageCatalogs'
interface Props { locale?: SupportedLocale }
const { locale = 'en-US' } = Astro.props
const content = getPageCatalog(locale).blog

const blog = await getCollection('blog')
---

<Layout locale={locale}>
  <SEOMeta 
    slot="head"
    title={content.metaTitle}
    description={content.description}
    documentType="List"
    searchTitle={content.searchTitle}
    locale={locale}
  />  
  <main id="main">
    <TopPageBanner title={content.banner} image="image-1" locale={locale}/>
    <section>
    {blog.length ? (
      <div class="mb-2 flex justify-end">
        <RSSFeed feedName={BLOG_FEED_PATH}/>
      </div>) : null
    }
    <MediaSearch listLength={blog.length} placeholder={content.searchPlaceholder} />
    <MediaCollection noResultsMessage={content.noResults}>
      {blog.map(paper => (
        <MediaCard
          searchString={`${paper.data.title} ${paper.data.authors.join(' ')}`.toLowerCase()}        
          title={paper.data.title} 
          image={paper.data.image} 
          summary={paper.data.summary}
          link={prefixPathForLocale(locale, getBlogPostPath(paper.id))}
        >
          <div>{paper.data.authors.join(', ')}</div>
          <div>{formatContentDate(paper.data.date, undefined, locale)}</div>
        </MediaCard>
      ))}      
    </MediaCollection>  
    <MediaNoItems listLength={blog.length} message={content.empty} />
    </section>
  </main>
</Layout>
