---
import BlogArticlePage from '@/components/i18n/BlogArticlePage.astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { getBlogEntrySlug, isBlogTranslationVisible } from '@/lib/blogRoutes'

export async function getStaticPaths() {
  const blogs = (await getCollection('blog')).filter((entry) => (
    entry.data.locale === 'en-US'
    && isBlogTranslationVisible('en-US', entry.data.translationStatus)
  ))
  return blogs.map((blog) => ({
    params: { slug: getBlogEntrySlug(blog.id) },
    props: { blog },
  }))
}

const { blog } = Astro.props as { blog: CollectionEntry<'blog'> }
---

<BlogArticlePage blog={blog} />
