---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import MediaCollection from '@/components/MediaCollection.astro'
import MediaCard from '@/components/MediaCard.astro'
import TopPageBanner from '@/components/TopPageBanner.astro'
import SEOMeta from '@/components/meta-data-helpers/SEOMeta.astro';
import MediaSearch from '@/components/MediaSearch.astro'
import MediaNoItems from '@/components/MediaNoItems.astro'
import { formatContentDate } from '@/lib/dates'
import { getWhitePaperPublication } from '@/lib/publications'
import TranslationReviewNotice from '@/components/i18n/TranslationReviewNotice.astro'
import type { SupportedLocale } from '@/i18n/locales'
import { arabicWhitePapers } from '@/i18n/arabicPages'
import { getPageCountLabel } from '@/i18n/messages'
interface Props { locale?: SupportedLocale }
const { locale = 'en-US' } = Astro.props
const isArabic = locale === 'ar'

const papers = await getCollection('white_papers')
const publications = papers.map((paper) => ({
  paper,
  paths: getWhitePaperPublication(paper, Astro.site),
}))
---

<title>{isArabic ? 'الأوراق البيضاء | Phaeno' : 'White Papers | Phaeno'}</title>
<meta name="description" content={isArabic ? 'اقرأ الأوراق البيضاء التقنية التي تنشرها Phaeno.' : 'Read technical White Papers published by Phaeno.'} />

<Layout locale={locale}>
  <SEOMeta 
    slot="head"
    title={isArabic ? 'الأوراق البيضاء | Phaeno' : 'White Papers | Phaeno'}
    description={isArabic ? 'اقرأ الصفحات العربية للأوراق التقنية التي تشرح منصة PSeq وبنيتها الجزيئية ومسار البيانات والتحقق التقني الأولي.' : "Learn about Phaeno's mission to transform molecular diagnostics through innovative RNA sequencing technology and expert leadership."}
    documentType="List"
    searchTitle={isArabic ? 'الأوراق البيضاء' : 'White Papers'}
    locale={locale}
  />    
  <main id="main">
    {isArabic ? <TranslationReviewNotice englishPath="/media/white-papers" /> : null}
    <TopPageBanner title={isArabic ? 'الأوراق البيضاء' : 'White Papers'} image="image-3" locale={locale}/>
    <section>
      <MediaSearch listLength={publications.length} placeholder={isArabic ? 'ابحث بالعنوان أو الموضوع' : 'Search title or topic'} />
      <MediaCollection noResultsMessage={isArabic ? 'لا توجد عناصر تطابق معايير البحث.' : 'No items match your search criteria'}>
        {isArabic ? arabicWhitePapers.map((page) => (
          <MediaCard
            searchString={`${page.title} ${page.whitePaper.topics.join(' ')}`.toLowerCase()}
            title={page.title}
            image={page.whitePaper.image}
            summary={page.description}
            link={page.route.ar}
          >
            <div>{formatContentDate(page.whitePaper.date, undefined, 'ar')} · {getPageCountLabel('ar', page.whitePaper.pageCount)}</div>
            <div>ملف PDF: الإنجليزية</div>
          </MediaCard>
        )) : publications.map(({ paper, paths }) => (
          <MediaCard 
            searchString={`${paper.data.title} ${paper.data.topics.join(' ')}`.toLowerCase()}
            title={paper.data.title} 
            image={paper.data.image} 
            summary={paper.data.summary}
            link={paths.landingPath}
          >
            <div>{formatContentDate(paper.data.date)} · {paper.data.pageCount} pages</div>
          </MediaCard>
        ))}      
      </MediaCollection>
      <MediaNoItems listLength={publications.length} message={isArabic ? 'لا توجد أوراق بيضاء. يُرجى العودة لاحقًا.' : 'No white papers, check back later.'} />
      <br />
    </section>
  </main>
</Layout>
