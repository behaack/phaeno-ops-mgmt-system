---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import MediaCollection from '@/components/MediaCollection.astro'
import MediaCard from '@/components/MediaCard.astro'
import TopPageBanner from '@/components/TopPageBanner.astro'
import SEOMeta from '@/components/meta-data-helpers/SEOMeta.astro';
import MediaSearch from '@/components/MediaSearch.astro'
import MediaNoItems from '@/components/MediaNoItems.astro'
import { formatContentDate } from '@/lib/dates'
import { getWhitePaperPublication } from '@/lib/publications'
import type { LocalizedLocale, SupportedLocale } from '@/i18n/locales'
import { getLocalizedWhitePapers } from '@/i18n/localizedPublications'
import { getPageCountLabel } from '@/i18n/messages'
import { getPageCatalog } from '@/i18n/pageCatalogs'
interface Props { locale?: SupportedLocale }
const { locale = 'en-US' } = Astro.props
const isTranslation = locale !== 'en-US'
const content = getPageCatalog(locale).whitePapers
const localizedPapers = isTranslation
  ? getLocalizedWhitePapers(locale as LocalizedLocale)
  : []

const papers = await getCollection('white_papers')
const publications = papers.map((paper) => ({
  paper,
  paths: getWhitePaperPublication(paper, Astro.site),
}))
---

<Layout locale={locale}>
  <SEOMeta 
    slot="head"
    title={content.metaTitle}
    description={content.description}
    documentType="List"
    searchTitle={content.searchTitle}
    locale={locale}
  />    
  <main id="main">
    <TopPageBanner title={content.banner} image="image-3" locale={locale}/>
    <section>
      <MediaSearch listLength={isTranslation ? localizedPapers.length : publications.length} placeholder={content.searchPlaceholder} />
      <MediaCollection noResultsMessage={content.noResults}>
        {isTranslation ? localizedPapers.map((page) => (
          <MediaCard
            searchString={`${page.title} ${page.whitePaper.topics.join(' ')}`.toLowerCase()}
            title={page.title}
            image={page.whitePaper.image}
            summary={page.description}
            link={page.route[locale as LocalizedLocale]}
          >
            <div>{formatContentDate(page.whitePaper.date, undefined, locale)} · {getPageCountLabel(locale, page.whitePaper.pageCount)}</div>
            <div>{content.pdfLanguage}</div>
          </MediaCard>
        )) : publications.map(({ paper, paths }) => (
          <MediaCard 
            searchString={`${paper.data.title} ${paper.data.topics.join(' ')}`.toLowerCase()}
            title={paper.data.title} 
            image={paper.data.image} 
            summary={paper.data.summary}
            link={paths.landingPath}
          >
            <div>{formatContentDate(paper.data.date)} · {paper.data.pageCount} pages</div>
          </MediaCard>
        ))}      
      </MediaCollection>
      <MediaNoItems listLength={isTranslation ? localizedPapers.length : publications.length} message={content.empty} />
      <br />
    </section>
  </main>
</Layout>
