---
import Layout from '@/layouts/Layout.astro';
import Tagline from '@/components/home-page-sections/Tagline.astro';
import SEOMeta from '@/components/meta-data-helpers/SEOMeta.astro';
import PerformanceMetrics from '@/components/PerformanceMetrics.astro';
import type { SupportedLocale } from '@/i18n/locales';
import { getPageCatalog } from '@/i18n/pageCatalogs';
import { getLocalizedPath } from '@/i18n/routes';

interface Props {
  locale?: SupportedLocale
}

const { locale = 'en-US' } = Astro.props
const content = getPageCatalog(locale).home

const homeTitle = content.metaTitle;
const homeDescription = content.metaDescription;
const siteUrl = new URL('/', Astro.site).href;
const organizationStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'Phaeno',
      legalName: 'Phaeno Inc.',
      url: siteUrl,
      logo: new URL('/images/phaeno-socialmedia-splash.webp', Astro.site).href,
      image: new URL('/images/phaeno-socialmedia-splash.webp', Astro.site).href,
      description: homeDescription,
      email: 'info@phaenobiotech.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '5270 California Avenue, Suite 300',
        addressLocality: 'Irvine',
        addressRegion: 'CA',
        postalCode: '92617',
        addressCountry: 'US',
      },
      sameAs: [
        'https://www.linkedin.com/company/phaeno-biotech/',
        'https://www.youtube.com/@phaenobiotech',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Phaeno',
      url: siteUrl,
      publisher: { '@id': `${siteUrl}#organization` },
    },
  ],
};

const platformFeatures = content.features
const performanceHighlights = content.metrics
const discovery = content.discovery
const platformCta = content.platformCta
---
<Layout locale={locale}>
  <SEOMeta 
    slot="head"
    title={homeTitle}
    description={homeDescription}
    documentType="Web Page"
    searchTitle={content.searchTitle}
    searchKeywords={content.searchKeywords}
    locale={locale}
  />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organizationStructuredData)} />

  <main class="home-main" id="main" tabindex="-1">
    <Tagline locale={locale} />

    <section class="platform-section">
      <div class="platform-intro">
        <div>
          <p class="section-kicker" data-phaeno-search-ignore>{discovery.kicker}</p>
          <h2
            id="pseq-intro"
            data-phaeno-search="PSeq phased sequencing platform overview"
            data-phaeno-search-summary="PSeq exposes molecular phenotype by resolving isoforms and transcript-specific regulation that gene-level summaries miss."
            data-phaeno-search-keywords="PSeq phased sequencing platform isoform regulation molecular phenotype gene counts"
          >{discovery.title}</h2>
        </div>

        <div class="platform-copy">
          <p>{discovery.paragraph}</p>
          <p class="platform-thesis">{discovery.thesis}</p>
          <div class="platform-links" data-phaeno-search-ignore>
            <a class="platform-links__featured" href={getLocalizedPath('/technology/multi-omics', locale)}>{discovery.multiOmics} <span aria-hidden="true">→</span></a>
            <a href={getLocalizedPath('/technology/why-isoforms-matter', locale)}>{discovery.isoforms} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>

      <div class="feature-grid">
        {platformFeatures.map((feature, index) => (
          <article
            class:list={['feature-card', { 'feature-card--lead': index === 0 }]}
          >
            <p class="feature-card__eyebrow" data-phaeno-search-ignore>{feature.eyebrow}</p>
            <h3
              id={feature.id}
              data-phaeno-search={feature.search}
              data-phaeno-search-summary={feature.summary}
            >
              {feature.title}
            </h3>
            <p class="feature-card__summary">{feature.summary}</p>
            {feature.href && (
              <a class="feature-card__link" href={feature.href}>
                {content.seeMore} <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))}
      </div>

      <div class="platform-cta" data-phaeno-search-ignore>
        <div class="platform-cta__inner">
          <div class="platform-cta__content">
            <div>
              <p class="section-kicker">{platformCta.kicker}</p>
              <p>{platformCta.body}</p>
            </div>
            <a href={getLocalizedPath('/technology/pseq-platform', locale)}>{platformCta.action} <span aria-hidden="true">→</span></a>
          </div>

          <dl class="platform-metrics" aria-label={platformCta.metricsLabel}>
            {performanceHighlights.map((metric) => (
              <div class="platform-metric">
                <dt>
                  {metric.label}
                  {metric.detail && <span>{metric.detail}</span>}
                </dt>
                <dd>{metric.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <div class="metrics-shell">
        <PerformanceMetrics locale={locale} />
      </div>
    </section>

    <section class="closing-cta" data-phaeno-search-ignore>
      <div class="closing-cta__inner">
        <p>
          {content.closing.map((line) => <span>{line}</span>)}
        </p>
        <div class="closing-cta__actions">
          <a class="closing-cta__primary" href={`${getLocalizedPath('/contact', locale)}#request-demo`}>{content.hero.requestDemo}</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
.home-main {
  container-type: inline-size;
  padding-top: 0;
}

.platform-section {
  padding-top: clamp(3rem, 5vw, 4.5rem);
}

.platform-intro {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, .85fr);
  gap: clamp(2rem, 4vw, 4rem);
  align-items: start;
}

.section-kicker {
  margin: 0 0 var(--space-3);
  padding: 0;
  color: var(--color-brand-strong);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: .16em;
  text-transform: uppercase;
}

.platform-intro h2 {
  max-width: 20ch;
  margin: 0;
  padding: 0;
  font-size: clamp(2.35rem, 4vw, 3.75rem);
  line-height: .98;
}

.platform-copy {
  padding-top: var(--space-8);
}

.platform-copy p {
  margin: 0;
  padding: 0;
  font-size: var(--font-size-lg);
  line-height: var(--line-height-relaxed);
}

.platform-copy .platform-thesis {
  margin-top: var(--space-5);
  color: var(--phaeno-rna-900);
  font-weight: var(--font-weight-semibold);
}

.platform-links {
  display: flex;
  flex-wrap: nowrap;
  gap: var(--space-3);
  margin-top: var(--space-6);
}

.platform-links a {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  padding: .7rem 1rem;
  border: 1px solid var(--phaeno-green-200);
  border-radius: var(--radius-pill);
  color: var(--color-brand-strong);
  background: var(--phaeno-green-50);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  transition:
    color var(--duration-fast) var(--ease-standard),
    background var(--duration-fast) var(--ease-standard),
    border-color var(--duration-fast) var(--ease-standard),
    transform var(--duration-fast) var(--ease-standard);
}

.platform-links a:hover {
  color: var(--color-text-on-dark);
  border-color: var(--color-brand-strong);
  background: var(--color-brand-strong);
  transform: translateY(-1px);
}

.platform-links a.platform-links__featured {
  color: var(--color-text-on-dark);
  border-color: var(--color-brand-strong);
  background: var(--color-brand-strong);
}

.platform-links a.platform-links__featured:hover {
  border-color: var(--phaeno-rna-900);
  background: var(--phaeno-rna-900);
}

.platform-links a span {
  transition: transform var(--duration-fast) var(--ease-standard);
}

.platform-links a:hover span {
  transform: translateX(2px);
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: 1fr;
  gap: var(--space-4);
  margin-top: clamp(1.5rem, 2vw, 2.5rem);
}

.feature-card {
  height: 100%;
  min-height: 16rem;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: var(--space-6) clamp(1.5rem, 3vw, 2.5rem);
  border: 1px solid var(--phaeno-green-200);
  border-radius: var(--radius-2xl);
  background: linear-gradient(155deg, var(--color-surface) 20%, var(--phaeno-green-50));
  box-shadow: var(--shadow-sm);
}

.feature-card:nth-child(n + 3) {
  justify-content: center;
}

.feature-card--lead {
  grid-column: auto;
  color: var(--color-text-on-dark);
  border-color: rgb(183 200 164 / .22);
  background:
    radial-gradient(circle at 80% 20%, rgb(28 127 152 / .3), transparent 40%),
    var(--phaeno-rna-900);
}

.feature-card__eyebrow {
  margin: 0;
  padding: 0;
  color: var(--color-brand-strong);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: .13em;
  text-transform: uppercase;
}

.feature-card--lead .feature-card__eyebrow {
  color: var(--phaeno-green-300);
}

.feature-card h3 {
  max-width: 18ch;
  margin: var(--space-6) 0 0;
  padding: 0;
  font-size: clamp(1.45rem, 2.4vw, 2.25rem);
  line-height: 1.08;
}

#ml-ready-outputs {
  max-width: 100%;
}

.feature-card--lead h3 {
  color: var(--color-text-on-dark);
}

.feature-card__title-line {
  white-space: nowrap;
}

.feature-card__summary {
  max-width: 38rem;
  margin: var(--space-4) 0 0;
  padding: 0;
  color: var(--color-text-muted);
  line-height: 1.55;
}

.feature-card--lead .feature-card__summary {
  color: rgb(255 255 255 / .7);
}

.feature-card__link {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: var(--space-2);
  margin-top: var(--space-5);
  color: var(--phaeno-green-200);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
}

.feature-card__link:hover {
  color: var(--color-text-on-dark);
}

.feature-card__link span {
  transition: transform var(--duration-fast) var(--ease-standard);
}

.feature-card__link:hover span {
  transform: translateX(2px);
}

.platform-cta {
  width: 100cqw;
  margin-inline: calc(50% - 50cqw);
  margin-top: var(--space-8);
  color: var(--color-text-on-dark);
  background:
    radial-gradient(circle at 78% 18%, rgb(28 127 152 / .28), transparent 38%),
    var(--phaeno-rna-900);
}

.platform-cta__inner {
  width: 100%;
  max-width: var(--content-max-width);
  margin: 0 auto;
  padding: clamp(3rem, 6vw, 5rem) var(--page-gutter);
}

.platform-cta__content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8);
}

.platform-cta .section-kicker {
  color: var(--phaeno-green-300);
}

.platform-cta__content p {
  max-width: 42rem;
  margin: 0;
  padding: 0;
}

.platform-cta__content > div > p:last-child {
  color: rgb(255 255 255 / .76);
  font-size: var(--font-size-lg);
  line-height: var(--line-height-relaxed);
}

.platform-cta__content > a {
  flex: 0 0 auto;
  display: inline-flex;
  gap: var(--space-3);
  padding: .8rem 1.1rem;
  color: var(--color-text-on-dark);
  background: var(--color-action-accent);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  transition:
    background-color var(--duration-base) var(--ease-standard),
    box-shadow var(--duration-base) var(--ease-standard),
    transform var(--duration-fast) var(--ease-standard);
}

.platform-cta__content > a:hover {
  color: var(--color-text-on-dark);
  background: var(--color-action-accent-hover);
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

.platform-cta__content > a span {
  transition: transform var(--duration-fast) var(--ease-standard);
}

.platform-cta__content > a:hover span {
  transform: translateX(2px);
}

.platform-metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin: clamp(2.5rem, 5vw, 4rem) 0 0;
  padding: clamp(1.75rem, 3vw, 2.5rem) 0 0;
  border-top: 1px solid rgb(255 255 255 / .2);
}

.platform-metric {
  display: flex;
  min-width: 0;
  flex-direction: column;
  padding: 0 clamp(1rem, 2.5vw, 2rem);
  border-left: 1px solid rgb(255 255 255 / .16);
}

.platform-metric:first-child {
  padding-left: 0;
  border-left: 0;
}

.platform-metric:last-child {
  padding-right: 0;
}

.platform-metric dt {
  margin: var(--space-2) 0 0;
  color: rgb(255 255 255 / .72);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-copy);
}

.platform-metric dt span {
  display: block;
}

.platform-metric dd {
  order: -1;
  margin: 0;
  color: var(--color-text-on-dark);
  font-size: clamp(1.75rem, 3vw, 2.4rem);
  font-weight: var(--font-weight-semibold);
  line-height: var(--line-height-tight);
}

.metrics-shell {
  margin-top: var(--space-12);
}

.closing-cta {
  max-width: none;
  padding: 0;
  background: var(--color-surface-rna);
}

.closing-cta__inner {
  width: 100%;
  max-width: var(--content-max-width);
  min-height: 13.5rem;
  margin: 0 auto;
  padding: clamp(3rem, 6vw, 5rem) var(--page-gutter);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8);
}

.closing-cta p {
  max-width: 32rem;
  margin: 0;
  padding: 0;
  color: var(--color-text-on-dark);
  font-size: clamp(1.5rem, 2.1vw, 1.9rem);
  font-weight: var(--font-weight-semibold);
  line-height: 1.18;
}

.closing-cta p span {
  display: block;
}

.closing-cta__actions {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.closing-cta__actions a {
  min-width: 9.5rem;
  padding: .9rem 1.4rem;
  border: 1px solid transparent;
  border-radius: var(--radius-pill);
  color: var(--color-text-on-dark);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  text-align: center;
  transition:
    background-color var(--duration-base) var(--ease-standard),
    box-shadow var(--duration-base) var(--ease-standard),
    transform var(--duration-fast) var(--ease-standard);
}

.closing-cta__primary {
  background: var(--color-action-accent);
}

.closing-cta__primary:hover {
  color: var(--color-text-on-dark);
  background: var(--color-action-accent-hover);
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

@media (max-width: 1150px) {
  .platform-intro {
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .platform-copy {
    max-width: 48rem;
    padding-top: 0;
  }
}

@media (max-width: 900px) {
  .feature-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 560px) {
  .platform-links {
    align-items: stretch;
    flex-direction: column;
  }

  .platform-links a {
    width: 100%;
    justify-content: space-between;
  }
}

@media (max-width: 640px) {
  .feature-grid {
    grid-template-columns: 1fr;
  }

  .feature-card--lead {
    grid-column: auto;
  }

  .feature-card {
    min-height: 17rem;
  }

  .feature-card:nth-child(n + 3) {
    justify-content: flex-start;
  }

  .platform-cta__content {
    align-items: stretch;
    flex-direction: column;
  }

  .platform-cta__content > a {
    justify-content: center;
  }

  .platform-metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    row-gap: var(--space-6);
  }

  .platform-metric {
    padding-inline: var(--space-4);
  }

  .platform-metric:nth-child(odd) {
    padding-left: 0;
    border-left: 0;
  }

  .platform-metric:nth-child(even) {
    padding-right: 0;
  }

  .platform-metric:nth-child(n + 3) {
    padding-top: var(--space-6);
    border-top: 1px solid rgb(255 255 255 / .16);
  }

  .closing-cta__inner {
    align-items: flex-start;
    flex-direction: column;
  }

  .closing-cta__actions {
    width: 100%;
    align-items: stretch;
    flex-direction: column;
  }
}
</style>
