---
import LocalizedPageRenderer from '@/components/i18n/LocalizedPageRenderer.astro'
import { getLocalizedWhitePaper } from '@/i18n/localizedPublications'
import { isSimplifiedChineseEnabled } from '@/i18n/locales'
import { getStaticLocalizedRoutePath, localizedRoutePairs } from '@/i18n/routes'

export function getStaticPaths() {
  if (!isSimplifiedChineseEnabled) return []

  return localizedRoutePairs.map((route) => ({
    params: { path: getStaticLocalizedRoutePath(route['zh-Hans'], 'zh-Hans') },
    props: {
      route,
      page: getLocalizedWhitePaper('zh-Hans', route.translationKey),
    },
  }))
}

const { route, page } = Astro.props
---

<LocalizedPageRenderer locale="zh-Hans" translationKey={route.translationKey} page={page} />
