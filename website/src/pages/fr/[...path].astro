---
import LocalizedPageRenderer from '@/components/i18n/LocalizedPageRenderer.astro'
import { getLocalizedWhitePaper } from '@/i18n/localizedPublications'
import { isFrenchEnabled } from '@/i18n/locales'
import { getStaticLocalizedRoutePath, localizedRoutePairs } from '@/i18n/routes'

export function getStaticPaths() {
  if (!isFrenchEnabled) return []

  return localizedRoutePairs.map((route) => ({
    params: { path: getStaticLocalizedRoutePath(route.fr, 'fr') },
    props: {
      route,
      page: getLocalizedWhitePaper('fr', route.translationKey),
    },
  }))
}

const { route, page } = Astro.props
---

<LocalizedPageRenderer locale="fr" translationKey={route.translationKey} page={page} />
