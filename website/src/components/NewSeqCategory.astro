---
import type { SupportedLocale } from '@/i18n/locales'
import { getPageCatalog } from '@/i18n/pageCatalogs'
interface Props { locale?: SupportedLocale }
const { locale = 'en-US' } = Astro.props
const content = getPageCatalog(locale).pseq.timeline
const stages = content.stages
---
<div
  class="sequencing-timeline"
  aria-label={content.label}
>
  {stages.map((stage) => <article class="timeline-stage"><div class="timeline-stage__meta"><span>{stage.phase}</span><time datetime={stage.year}>{stage.year}</time></div><h3>{stage.title}</h3><p>{stage.copy}</p></article>)}

  <article class="timeline-stage timeline-stage--pseq">
    <div class="timeline-stage__meta">
      <span>{content.resolution}</span>
      <time datetime="2025">2025</time>
    </div>
    <div class="timeline-stage__pseq-title">
      <span>{content.phasedSequencing}</span>
      <strong>PSeq</strong>
    </div>
    <p>{content.molecularIdentity} <span>•</span> NGS <span>•</span> {content.isoformAssembly}</p>
  </article>
</div>

<style>
  .sequencing-timeline {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.18fr);
    gap: var(--space-4);
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--phaeno-green-200);
    border-radius: var(--radius-xl);
    background: var(--phaeno-green-50);
  }

  .timeline-stage {
    position: relative;
    display: flex;
    min-height: 13.5rem;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border: 1px solid var(--phaeno-green-200);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .timeline-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    z-index: 2;
    top: 50%;
    right: -1px;
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: 1px solid var(--phaeno-green-200);
    border-radius: 50%;
    color: var(--color-brand-strong);
    background: var(--color-surface);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    padding-bottom: 2px;
    transform: translate(50%, -50%);
  }

  .timeline-stage__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--color-brand-strong);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .timeline-stage__meta time {
    color: var(--phaeno-rna-900);
    font-family: var(--font-family-data);
    font-size: var(--font-size-sm);
    letter-spacing: 0;
  }

  .timeline-stage h3 {
    margin: var(--space-7) 0 var(--space-3);
    color: var(--phaeno-rna-900);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.08;
  }

  .timeline-stage > p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .timeline-stage--pseq {
    overflow: hidden;
    color: var(--color-text-on-dark);
    border-color: var(--phaeno-rna-800);
    background:
      radial-gradient(circle at 100% 0%, rgb(28 127 152 / 35%), transparent 42%),
      var(--phaeno-rna-900);
  }

  .timeline-stage--pseq::before {
    content: '';
    position: absolute;
    right: -3.5rem;
    bottom: -5rem;
    width: 12rem;
    height: 12rem;
    border: 1px solid rgb(214 227 195 / 22%);
    border-radius: 50%;
  }

  .timeline-stage--pseq .timeline-stage__meta,
  .timeline-stage--pseq .timeline-stage__meta time {
    color: var(--phaeno-green-200);
  }

  .timeline-stage__pseq-title {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: var(--space-6) 0;
  }

  .timeline-stage__pseq-title span {
    color: var(--phaeno-neutral-200);
    font-size: var(--font-size-md);
  }

  .timeline-stage__pseq-title strong {
    color: var(--color-text-on-dark);
    font-size: clamp(2.1rem, 3vw, 3rem);
    line-height: 1;
  }

  .timeline-stage--pseq > p {
    position: relative;
    z-index: 1;
    color: var(--phaeno-green-200);
    font-family: var(--font-family-data);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    line-height: 1.55;
    text-transform: uppercase;
  }

  .timeline-stage--pseq > p span {
    color: var(--phaeno-orange-500);
  }

  @media (max-width: 900px) {
    .sequencing-timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .timeline-stage:not(:last-child)::after {
      display: none;
    }
  }

  @media (max-width: 540px) {
    .sequencing-timeline {
      grid-template-columns: 1fr;
      padding: var(--space-3);
    }

    .timeline-stage {
      min-height: 11rem;
    }

    .timeline-stage h3 {
      margin-top: var(--space-5);
    }
  }
</style>
