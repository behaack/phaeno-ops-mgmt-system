---
import { getMessages } from '@/i18n/messages'

interface Props {
  englishPath: string
}

const { englishPath } = Astro.props as Props
const text = getMessages('ar').arabicPreview
---

<aside class="translation-review" data-phaeno-search-ignore>
  <span>{text.reviewNotice}</span>
  <a href={englishPath} hreflang="en-US" lang="en-US" dir="ltr">{text.englishSource}</a>
</aside>

<style>
.translation-review {
  display: flex;
  justify-content: center;
  gap: var(--space-4);
  align-items: center;
  width: 100%;
  padding: var(--space-3) var(--page-gutter);
  border-block-end: 1px solid #d8b657;
  color: #4d3a08;
  background: #fff8dd;
  font-size: var(--font-size-sm);
}

.translation-review a {
  color: inherit;
  font-weight: var(--font-weight-semibold);
}

@media (max-width: 725px) {
  .translation-review {
    align-items: flex-start;
    flex-direction: column;
  }
}
</style>
