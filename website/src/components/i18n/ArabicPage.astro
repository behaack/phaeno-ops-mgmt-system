---
import Layout from '@/layouts/Layout.astro'
import SEOMeta from '@/components/meta-data-helpers/SEOMeta.astro'
import PublicationSEOMeta from '@/components/meta-data-helpers/PublicationSEOMeta.astro'
import MediaArticlePage from '@/components/MediaArticlePage.astro'
import ContactUsForms from '@/components/contact-forms/ContactUsForms'
import TranslationReviewNotice from '@/components/i18n/TranslationReviewNotice.astro'
import ReCaptchaNotification from '@/components/ReCaptchaNotification.astro'
import { arabicWhitePapers, type ArabicPage } from '@/i18n/arabicPages'
import { getMessages, getPageCountLabel } from '@/i18n/messages'
import { formatContentDate } from '@/lib/dates'

interface Props {
  page: ArabicPage
}

const { page } = Astro.props as Props
const paper = page.whitePaper
const landingUrl = new URL(page.route.ar, Astro.site).href
const siteUrl = new URL('/', Astro.site).href
const text = getMessages('ar').arabicPreview
---

<Layout locale="ar">
  {paper ? (
    <PublicationSEOMeta
      slot="head"
      title={page.metaTitle}
      description={page.description}
      datePublished={new Date(paper.date)}
      landingUrl={landingUrl}
      pdfUrl={new URL(paper.pdfPath, siteUrl).href}
      imageUrl={new URL(paper.image, siteUrl).href}
      pageCount={paper.pageCount}
      version={paper.version}
      topics={paper.topics}
      searchKeywords={paper.searchKeywords}
      locale="ar"
      assetLanguage="en-US"
    />
  ) : (
    <SEOMeta
      slot="head"
      title={page.metaTitle}
      description={page.description}
      documentType={page.kind === 'white-paper-list' || page.kind === 'empty-list' ? 'List' : 'Web Page'}
      searchTitle={page.title}
      locale="ar"
    />
  )}

  {paper ? (
    <>
      <TranslationReviewNotice englishPath={page.route.enUS} />
      <MediaArticlePage
        locale="ar"
        title={page.title}
        summary={page.description}
        image={paper.image}
        imagePosition="left"
        date={new Date(paper.date)}
        eyebrow={page.eyebrow}
        backHref="/ar/media/white-papers"
        backLabel={text.backToWhitePapers}
        headerActionHref={paper.pdfPath}
        headerActionLabel={text.downloadEnglishPdf}
        pageCount={paper.pageCount}
        version={paper.version}
        compactContentSpacing
      >
        {page.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets ? <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul> : null}
          </section>
        ))}
        <p class="asset-language-note" data-phaeno-search-ignore>
          {text.englishPdfDisclosure}
        </p>
      </MediaArticlePage>
    </>
  ) : (
    <main id="main" class="arabic-page" tabindex="-1">
      <TranslationReviewNotice englishPath={page.route.enUS} />
      <header class="arabic-hero">
        <div class="arabic-hero__inner">
          <p>{page.eyebrow}</p>
          <h1 data-phaeno-search={page.title} data-phaeno-search-summary={page.description}>{page.title}</h1>
          <div class="arabic-hero__lead">{page.lead}</div>
        </div>
      </header>

      <div class="arabic-content">
        {page.kind === 'white-paper-list' ? (
          <section aria-labelledby="arabic-white-papers">
            <h2 id="arabic-white-papers">{text.whitePaperSeries}</h2>
            <div class="publication-grid">
              {arabicWhitePapers.map((publicationPage) => (
                <article class="publication-card">
                  <img src={publicationPage.whitePaper.image} alt="" loading="lazy" />
                  <div>
                    <p class="publication-card__meta">
                      {formatContentDate(publicationPage.whitePaper.date, { year: 'numeric', month: 'long', day: 'numeric' }, 'ar')}
                      {' · '}
                      {getPageCountLabel('ar', publicationPage.whitePaper.pageCount)}
                    </p>
                    <h3><a href={publicationPage.route.ar}>{publicationPage.title}</a></h3>
                    <p>{publicationPage.description}</p>
                    <p class="publication-card__asset">{text.pdfLanguageEnglish}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ) : null}

        {page.kind === 'empty-list' ? (
          <section class="empty-state" aria-live="polite">
            <h2>{text.noPublishedContent}</h2>
            <p>{page.emptyMessage}</p>
          </section>
        ) : null}

        {page.sections.map((section) => (
          <section class="content-section">
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => (
              paragraph.includes('@') ? <p><bdi>{paragraph}</bdi></p> : <p>{paragraph}</p>
            ))}
            {section.bullets ? <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul> : null}
          </section>
        ))}

        {page.kind === 'contact' ? (
          <>
            <ContactUsForms locale="ar" client:load />
            <ReCaptchaNotification locale="ar" />
          </>
        ) : null}
      </div>
    </main>
  )}
</Layout>

<style>
.arabic-page {
  container-type: inline-size;
  width: 100%;
  color: var(--color-text);
  background: var(--color-canvas);
}

.arabic-hero {
  width: 100%;
  padding: clamp(4rem, 8vw, 7.5rem) var(--page-gutter);
  color: var(--color-text-on-dark);
  background:
    radial-gradient(circle at 18% 18%, rgb(28 127 152 / .32), transparent 34%),
    var(--phaeno-rna-900);
}

.arabic-hero__inner {
  width: min(100%, 72rem);
  margin: 0 auto;
}

.arabic-hero p {
  margin: 0;
  color: var(--phaeno-green-300);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
}

.arabic-hero h1 {
  max-width: 56rem;
  margin: var(--space-4) 0 0;
  color: inherit;
  font-size: clamp(2.7rem, 6vw, 5.5rem);
  font-weight: var(--font-weight-medium);
  letter-spacing: -.025em;
  line-height: 1.15;
  text-wrap: balance;
}

.arabic-hero__lead {
  max-width: 52rem;
  margin-block-start: var(--space-6);
  color: rgb(255 255 255 / .78);
  font-size: clamp(1.2rem, 2vw, 1.55rem);
  line-height: 1.8;
}

.arabic-content {
  width: min(100% - (2 * var(--page-gutter)), 72rem);
  margin: 0 auto;
  padding: clamp(3rem, 6vw, 6rem) 0;
}

.content-section + .content-section,
.empty-state + .content-section {
  margin-block-start: clamp(3rem, 6vw, 5rem);
}

.content-section {
  max-width: 55rem;
}

.content-section h2,
.arabic-content > section > h2 {
  margin: 0 0 var(--space-5);
  color: var(--phaeno-rna-900);
  font-size: clamp(1.8rem, 3vw, 2.75rem);
  line-height: 1.25;
}

.content-section p,
.content-section li,
.empty-state p {
  color: var(--color-text-muted);
  font-size: var(--font-size-lg);
  line-height: 1.9;
}

.content-section ul {
  padding-inline-start: 1.5rem;
}

.publication-grid {
  display: grid;
  gap: var(--space-6);
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.publication-card {
  overflow: hidden;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  background: var(--color-surface);
  box-shadow: var(--shadow-sm);
}

.publication-card > img {
  width: 100%;
  aspect-ratio: 16 / 7;
  object-fit: cover;
}

.publication-card > div {
  padding: var(--space-6);
}

.publication-card h3 {
  margin: var(--space-2) 0 var(--space-3);
  font-size: var(--font-size-xl);
  line-height: 1.45;
}

.publication-card p {
  color: var(--color-text-muted);
  line-height: 1.7;
}

.publication-card__meta,
.publication-card__asset {
  font-size: var(--font-size-sm);
}

.publication-card__asset,
.asset-language-note {
  padding: var(--space-3) var(--space-4);
  border-inline-start: 4px solid var(--phaeno-green-500);
  background: var(--phaeno-green-50);
}

.empty-state {
  padding: var(--space-8);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  background: var(--color-surface);
}

@media (max-width: 725px) {
  .publication-grid {
    grid-template-columns: 1fr;
  }
}
</style>
