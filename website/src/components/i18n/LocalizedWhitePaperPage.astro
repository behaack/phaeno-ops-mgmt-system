---
import Layout from '@/layouts/Layout.astro'
import PublicationSEOMeta from '@/components/meta-data-helpers/PublicationSEOMeta.astro'
import MediaArticlePage from '@/components/MediaArticlePage.astro'
import type { LocalizedLocale } from '@/i18n/locales'
import type { LocalizedPublicationPage } from '@/i18n/publicationTypes'
import { getMessages } from '@/i18n/messages'
import { prefixPathForLocale } from '@/i18n/locales'

interface Props {
  locale: LocalizedLocale
  page: LocalizedPublicationPage
}

const { locale, page } = Astro.props as Props
const paper = page.whitePaper
const landingUrl = new URL(page.route[locale], Astro.site).href
const siteUrl = new URL('/', Astro.site).href
const text = getMessages(locale).localizedPublication
---

<Layout locale={locale}>
  <PublicationSEOMeta
    slot="head"
    title={page.metaTitle}
    description={page.description}
    datePublished={new Date(paper.date)}
    landingUrl={landingUrl}
    pdfUrl={new URL(paper.pdfPath, siteUrl).href}
    imageUrl={new URL(paper.image, siteUrl).href}
    pageCount={paper.pageCount}
    version={paper.version}
    topics={paper.topics}
    searchKeywords={paper.searchKeywords}
    locale={locale}
    assetLanguage="en-US"
  />

  <MediaArticlePage
    locale={locale}
    title={page.title}
    summary={page.description}
    image={paper.image}
    imagePosition="left"
    date={new Date(paper.date)}
    eyebrow={page.eyebrow}
    backHref={prefixPathForLocale(locale, '/media/white-papers')}
    backLabel={text.backToWhitePapers}
    headerActionHref={paper.pdfPath}
    headerActionLabel={text.downloadEnglishPdf}
    pageCount={paper.pageCount}
    version={paper.version}
    compactContentSpacing
  >
    {page.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        {section.bullets ? <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul> : null}
      </section>
    ))}
    <p class="asset-language-note" data-phaeno-search-ignore>
      {text.englishPdfDisclosure}
    </p>
  </MediaArticlePage>
</Layout>

<style>
.asset-language-note {
  padding: var(--space-3) var(--space-4);
  border-inline-start: 4px solid var(--phaeno-green-500);
  background: var(--phaeno-green-50);
}
</style>
