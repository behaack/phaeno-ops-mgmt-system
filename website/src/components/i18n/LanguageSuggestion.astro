---
import { formatMessage, getMessages } from '@/i18n/messages'
import { locales, type LocalizedLocale } from '@/i18n/locales'

interface LocalePath {
  locale: LocalizedLocale
  path: string
}

interface Props {
  alternates: LocalePath[]
}

const { alternates } = Astro.props as Props
const message = getMessages('en-US').language
---

{alternates.map((item) => {
  const target = locales[item.locale]
  const values = { language: target.administrativeName }
  return (
    <aside
      class="language-suggestion"
      data-language-suggestion={item.locale}
      aria-labelledby={`language-suggestion-title-${item.locale}`}
      hidden
    >
      <div>
        <strong id={`language-suggestion-title-${item.locale}`}>
          {formatMessage(message.suggestionTitle, values)}
        </strong>
        <p>{formatMessage(message.suggestionBody, values)}</p>
      </div>
      <div class="language-suggestion__actions">
        <a
          href={item.path}
          data-language-suggestion-accept
          data-target-locale={item.locale}
        >
          {formatMessage(message.accept, values)}
        </a>
        <button type="button" data-language-suggestion-dismiss>{message.dismiss}</button>
      </div>
    </aside>
  )
})}

<script>
  const readCookie = (name: string) => {
    const prefix = `${name}=`
    const value = document.cookie.split(';').map((part) => part.trim()).find((part) => part.startsWith(prefix))
    return value ? decodeURIComponent(value.slice(prefix.length)) : undefined
  }

  const suggestions = [...document.querySelectorAll<HTMLElement>('[data-language-suggestion]')]
  if (suggestions.length > 0) {
    const availableLocales = suggestions
      .map((suggestion) => suggestion.dataset.languageSuggestion)
      .filter((locale): locale is string => Boolean(locale))
    const normalizeLocale = (language: string) => {
      const normalized = language.toLowerCase()
      if (normalized === 'ar' || normalized.startsWith('ar-')) return 'ar'
      if (normalized === 'fr' || normalized.startsWith('fr-')) return 'fr'
      return undefined
    }
    const preferredLocale = readCookie('phaeno_locale')
    const promptState = readCookie('phaeno_locale_prompt')
    const detectedLocale = preferredLocale && availableLocales.includes(preferredLocale)
      ? preferredLocale
      : navigator.languages.map(normalizeLocale).find((locale) => locale && availableLocales.includes(locale))
    const suggestion = suggestions.find((item) => item.dataset.languageSuggestion === detectedLocale)

    if (promptState !== 'dismissed' && suggestion) suggestion.hidden = false

    suggestion?.querySelector<HTMLElement>('[data-language-suggestion-accept]')?.addEventListener('click', () => {
      const targetLocale = suggestion.querySelector<HTMLElement>('[data-target-locale]')?.dataset.targetLocale
      if (!targetLocale) return
      const secure = window.location.protocol === 'https:' ? '; Secure' : ''
      document.cookie = `phaeno_locale=${encodeURIComponent(targetLocale)}; Path=/; Max-Age=31536000; SameSite=Lax${secure}`
      document.cookie = `phaeno_locale_prompt=; Path=/; Max-Age=0; SameSite=Lax${secure}`
    })

    suggestion?.querySelector('[data-language-suggestion-dismiss]')?.addEventListener('click', () => {
      const secure = window.location.protocol === 'https:' ? '; Secure' : ''
      document.cookie = `phaeno_locale=en-US; Path=/; Max-Age=31536000; SameSite=Lax${secure}`
      document.cookie = `phaeno_locale_prompt=dismissed; Path=/; Max-Age=15552000; SameSite=Lax${secure}`
      suggestion.hidden = true
    })
  }
</script>

<style>
.language-suggestion {
  position: fixed;
  inset-block-start: calc(var(--header-height) + var(--space-3));
  inset-inline-end: var(--page-gutter);
  z-index: 45;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--space-5);
  align-items: center;
  width: min(34rem, calc(100vw - (2 * var(--page-gutter))));
  padding: var(--space-4);
  border: 1px solid var(--phaeno-green-300);
  border-radius: var(--radius-xl);
  color: var(--color-text);
  background: rgb(255 255 255 / .98);
  box-shadow: var(--shadow-overlay);
}

.language-suggestion[hidden] {
  display: none;
}

.language-suggestion p {
  margin: var(--space-1) 0 0;
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
}

.language-suggestion__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.language-suggestion__actions a,
.language-suggestion__actions button {
  min-height: 2.5rem;
  padding: .65rem .85rem;
  border: 1px solid var(--color-action-primary);
  border-radius: var(--radius-pill);
  font: inherit;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  cursor: pointer;
}

.language-suggestion__actions a {
  color: var(--color-text-on-dark);
  background: var(--color-action-primary);
  text-decoration: none;
}

.language-suggestion__actions button {
  color: var(--color-text);
  background: var(--color-surface);
}

@media (max-width: 640px) {
  .language-suggestion {
    inset-block-start: 4.5rem;
    grid-template-columns: 1fr;
  }
}
</style>
