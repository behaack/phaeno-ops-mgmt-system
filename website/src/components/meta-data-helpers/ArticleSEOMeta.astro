---
/** Standard metadata and structured data for article-like content. */
import type { articletypes, webtypes } from '@/assets/docTypes'
import { getLocaleDefinition, type SupportedLocale } from '@/i18n/locales'

type ArticleSchemaType = 'Article' | 'BlogPosting' | 'NewsArticle' | 'ScholarlyArticle'

interface Props {
  title: string;
  description: string;
  documentType: webtypes | articletypes;
  authors?: string[];
  datePosted: Date;
  dateModified?: Date;
  schemaType?: ArticleSchemaType;
  /** Absolute page URL (defaults to Astro.url) */
  url?: string;
  /** Social-card image (defaults to site-wide card) */
  image?: string;
  /** Twitter card type */
  twitterCard?: 'summary' | 'summary_large_image';
  /** Internal site-search terms, not external SEO keywords */
  searchKeywords?: string;
  /** Internal site-search page label, separate from the SEO title */
  searchTitle?: string;
  locale?: SupportedLocale;
}

const {
  title,
  description,
  documentType,
  authors=[],
  datePosted,
  dateModified,
  schemaType = 'Article',
  url = new URL(Astro.url.pathname, Astro.site).href,
  image = '/images/phaeno-socialmedia-splash.webp',
  twitterCard = 'summary_large_image',
  searchKeywords = '',
  searchTitle = '',
  locale = 'en-US',
} = Astro.props as Props;

const canonicalUrl = new URL(url, Astro.site ?? Astro.url).href;
const siteUrl = new URL('/', canonicalUrl).href;
const imageUrl = new URL(image, siteUrl).href;
const openGraphLocale = getLocaleDefinition(locale).openGraphLocale;
const shouldEmitOpenGraphLocale = locale !== 'en-US';
const publishedIso = datePosted.toISOString();
const modifiedIso = dateModified?.toISOString();
const normalizedAuthors = [...new Set(authors.map((author) => author.trim()).filter(Boolean))];
const organizationId = `${siteUrl}#organization`;
const websiteId = `${siteUrl}#website`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  '@id': `${canonicalUrl}#article`,
  headline: title,
  description,
  url: canonicalUrl,
  datePublished: publishedIso,
  ...(modifiedIso ? { dateModified: modifiedIso } : {}),
  inLanguage: locale,
  isAccessibleForFree: true,
  image: [imageUrl],
  author: normalizedAuthors.length
    ? normalizedAuthors.map((name) => ({ '@type': 'Person', name }))
    : [{ '@type': 'Organization', '@id': organizationId, name: 'Phaeno' }],
  publisher: {
    '@type': 'Organization',
    '@id': organizationId,
    name: 'Phaeno',
    legalName: 'Phaeno Inc.',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/phaeno-socialmedia-splash.webp', siteUrl).href,
    },
  },
  isPartOf: {
    '@type': 'WebSite',
    '@id': websiteId,
    name: 'Phaeno',
    url: siteUrl,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
const serializedStructuredData = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="phaeno:document-type" content={documentType} />
{searchTitle ? <meta name="phaeno:search-title" content={searchTitle} /> : null}
{searchKeywords ? <meta name="phaeno:search-keywords" content={searchKeywords} /> : null}
{normalizedAuthors.length ? <meta name="author" content={normalizedAuthors.join(', ')} /> : null}
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:type"        content="article" />
<meta property="og:site_name"   content="Phaeno" />
<meta property="og:url"         content={canonicalUrl} />
<meta property="og:title"       content={title} />
<meta property="og:description" content={description} />
<meta property="og:image"       content={imageUrl} />
{shouldEmitOpenGraphLocale ? <meta property="og:locale" content={openGraphLocale} /> : null}
<meta property="article:published_time" content={publishedIso} />
{modifiedIso ? <meta property="article:modified_time" content={modifiedIso} /> : null}
{normalizedAuthors.map((author) => <meta property="article:author" content={author} />)}

<!-- Twitter -->
<meta name="twitter:card"        content={twitterCard} />
<meta name="twitter:site"        content="@Phaeno" />
<meta name="twitter:title"       content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={imageUrl} />

<script type="application/ld+json" set:html={serializedStructuredData} />
