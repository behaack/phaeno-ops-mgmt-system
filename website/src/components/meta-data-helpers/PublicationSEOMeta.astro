---
interface Props {
  title: string
  description: string
  datePublished: Date
  dateModified?: Date
  landingUrl: string
  pdfUrl: string
  imageUrl: string
  pageCount: number
  version?: string
  topics: string[]
  searchKeywords: string[]
  locale?: 'en-US' | 'ar'
  assetLanguage?: 'en-US' | 'ar'
}

const {
  title,
  description,
  datePublished,
  dateModified,
  landingUrl,
  pdfUrl,
  imageUrl,
  pageCount,
  version,
  topics,
  searchKeywords,
  locale = 'en-US',
  assetLanguage = 'en-US',
} = Astro.props as Props

const publishedIso = datePublished.toISOString()
const modifiedIso = dateModified?.toISOString()
const siteUrl = new URL('/', landingUrl).href
const organizationId = `${siteUrl}#organization`
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${landingUrl}#article`,
  headline: title,
  description,
  url: landingUrl,
  datePublished: publishedIso,
  ...(modifiedIso ? { dateModified: modifiedIso } : {}),
  inLanguage: locale,
  isAccessibleForFree: true,
  image: [imageUrl],
  articleSection: topics,
  about: topics.map((name) => ({ '@type': 'Thing', name })),
  keywords: searchKeywords,
  publisher: {
    '@type': 'Organization',
    '@id': organizationId,
    name: 'Phaeno',
    legalName: 'Phaeno Inc.',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/phaeno-socialmedia-splash.webp', siteUrl).href,
    },
  },
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: 'Phaeno',
    url: siteUrl,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': landingUrl,
  },
  encoding: {
    '@type': 'MediaObject',
    name: `${title} PDF`,
    contentUrl: pdfUrl,
    encodingFormat: 'application/pdf',
    isAccessibleForFree: true,
    inLanguage: assetLanguage,
  },
}
const serializedStructuredData = JSON.stringify(structuredData).replace(/</g, '\\u003c')
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="phaeno:document-type" content="White Paper" />
<meta name="phaeno:search-title" content={`White Paper - ${title}`} />
<meta name="phaeno:search-keywords" content={searchKeywords.join(', ')} />
<meta name="phaeno:search-mode" content="document" />
<meta name="phaeno:search-source" content={pdfUrl} />
<meta name="phaeno:search-source-type" content="application/pdf" />
<meta name="phaeno:search-source-language" content={assetLanguage} />
<meta name="phaeno:publication-page-count" content={String(pageCount)} />
{version ? <meta name="phaeno:publication-version" content={version} /> : null}
<link rel="canonical" href={landingUrl} />

<meta property="og:type" content="article" />
<meta property="og:site_name" content="Phaeno" />
<meta property="og:url" content={landingUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
{locale !== 'en-US' ? <meta property="og:locale" content="ar_AR" /> : null}
<meta property="article:published_time" content={publishedIso} />
{modifiedIso ? <meta property="article:modified_time" content={modifiedIso} /> : null}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@Phaeno" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={serializedStructuredData} />
