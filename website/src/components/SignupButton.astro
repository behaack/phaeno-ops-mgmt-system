---
import { getMessages } from '@/i18n/messages'
import { getLocalizedPath } from '@/i18n/routes'
import type { SupportedLocale } from '@/i18n/locales'

interface IProps {
  size: 'narrow' | 'wide'
  locale?: SupportedLocale
}

const { size, locale = 'en-US' } = Astro.props as IProps
const text = getMessages(locale)
const href = `${getLocalizedPath('/contact', locale) ?? '/contact'}#request-demo`
---

<a
  href={href}
  role="button"
  aria-label={text.requestDemo}
>
  <span>
    {text.requestDemoSegments.map((segment, index) => (
      <>{index > 0 && (size === 'narrow' ? <br /> : ' ')}{segment}</>
    ))}
  </span>
</a>

<style>
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    background: var(--color-action-accent);
    color: var(--color-text-on-dark);
    padding: .65rem 1rem;
    border: 1px solid var(--color-action-accent);
    border-radius: var(--radius-pill);
    text-decoration: none;
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    transition: transform var(--duration-fast) var(--ease-standard), background var(--duration-base) var(--ease-standard), box-shadow var(--duration-base) var(--ease-standard);
  }

  a:hover {
    color: var(--color-text-on-dark);
    background: var(--color-action-accent-hover);
    border-color: var(--color-action-accent-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  a:active {
    box-shadow: none;
    transform: scale(1);
  }

  a > span {
    text-align: center;
    letter-spacing: .01em;
  }
</style>
