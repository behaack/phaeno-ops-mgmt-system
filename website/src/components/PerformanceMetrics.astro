---
import type { SupportedLocale } from '@/i18n/locales'
import { getPageCatalog } from '@/i18n/pageCatalogs'

interface Props {
  locale?: SupportedLocale
}

type CellStatus = 'yes' | 'no' | 'partial' | undefined

const { locale = 'en-US' } = Astro.props
const content = getPageCatalog(locale).performance
const cellStatuses: readonly (readonly CellStatus[])[] = [
  ['yes', 'no', 'yes'],
  ['yes', 'no', 'partial'],
  ['yes', 'no', 'yes'],
  ['yes', 'partial', 'partial'],
  ['yes', 'partial', 'no'],
  ['yes', 'no', 'no'],
  ['yes', 'no', 'no'],
  ['yes', 'partial', 'no'],
  ['yes', 'yes', 'no'],
  ['yes', 'no', 'no'],
]

function cellState(status: CellStatus) {
  if (status === 'yes') return { symbol: '✓', className: 'status--yes', label: content.yes }
  if (status === 'no') return { symbol: '✕', className: 'status--no', label: content.no }
  if (status === 'partial') return { symbol: '◐', className: 'status--partial' }
  return undefined
}
---

<div class="comparison">
  <div class="comparison__header">
    <h2
      id="performance-metrics"
      data-phaeno-search="PSeq performance metrics and RNA sequencing comparison"
      data-phaeno-search-summary={content.intro}
      data-phaeno-search-keywords="PSeq performance RNA-Seq long-read sequencing short-read sequencing rare isoforms full-length recovery pri-miRNA pre-miRNA mature miRNA NGS compatible ML-ready"
    >{content.title}</h2>
    <p>{content.intro}</p>
  </div>

  <div class="comparison__table-wrap">
    <table>
      <caption class="sr-only">{content.caption}</caption>
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">{content.metric}</span></th>
          <th scope="col" class="pseq-heading"><span class="pseq-heading__label">PSeq</span></th>
          <th scope="col">{content.shortRead}<sup>1</sup></th>
          <th scope="col">{content.longRead}<sup>2</sup></th>
        </tr>
      </thead>
      <tbody>
        {content.rows.map((row, rowIndex) => (
          <tr class:list={{ 'metrics-start': rowIndex === 10 }}>
            <th scope="row">{row[0]}</th>
            {row.slice(1).map((value, columnIndex) => {
              const state = cellState(cellStatuses[rowIndex]?.[columnIndex])
              const label = columnIndex === 0 ? 'PSeq' : columnIndex === 1 ? content.shortRead : content.longRead
              const isStatusOnly = value === 'yes' || value === 'no'
              return (
                <td data-label={label} class:list={{ 'pseq-value': columnIndex === 0 && rowIndex >= 10 }}>
                  {state ? (
                    <>
                      <span class:list={['status', state.className]} aria-hidden="true">{state.symbol}</span>
                      {isStatusOnly
                        ? <span class="sr-only">{state.label}</span>
                        : <span>{value}</span>}
                    </>
                  ) : value}
                </td>
              )
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="comparison__notes">
    <p>{content.notes}</p>
    <p>{content.ruo}</p>
  </div>
</div>

<style>
.comparison {
  width: 100%;
}

.comparison__header {
  margin-bottom: var(--space-8);
}

.comparison__header h2 {
  margin: 0;
  padding: 0;
  color: var(--phaeno-rna-900);
  font-size: clamp(2rem, 3.2vw, 3rem);
  line-height: 1.05;
}

.comparison__header p {
  max-width: none;
  margin: var(--space-3) 0 0;
  padding: 0;
  color: var(--color-text-muted);
  font-size: var(--font-size-lg);
}

.comparison__table-wrap {
  width: 100%;
}

table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}

thead {
  border-bottom: 2px solid var(--phaeno-neutral-900);
}

thead th {
  padding: .9rem 1rem;
  color: var(--phaeno-rna-900);
  font-family: var(--font-family-data);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  text-align: left;
}

thead th:first-child {
  width: 25%;
}

thead th:nth-child(2) {
  width: 22%;
}

thead th:nth-child(3),
thead th:nth-child(4) {
  width: 26.5%;
}

.pseq-heading,
.pseq-value {
  color: var(--phaeno-rna-600);
}

.pseq-heading {
  font-weight: var(--font-weight-bold);
}

.pseq-heading__label {
  display: inline-flex;
  align-items: center;
  padding: .35rem .75rem;
  border-radius: 999px;
  color: var(--color-text-on-dark);
  background: var(--phaeno-rna-900);
  font-family: var(--font-family-sans);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
  letter-spacing: .01em;
}

tbody tr {
  border-bottom: 1px solid var(--phaeno-neutral-200);
}

tbody th,
tbody td {
  padding: .9rem 1rem;
  vertical-align: top;
  text-align: left;
}

tbody th {
  color: var(--color-text);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  line-height: 1.35;
}

tbody td {
  color: var(--color-text-muted);
  font-family: ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', monospace;
  font-size: .78rem;
  line-height: 1.5;
}

tbody td:nth-child(2) {
  color: var(--phaeno-rna-600);
}

.metrics-start {
  border-top: 2px solid var(--phaeno-neutral-900);
}

.status {
  display: inline-block;
  min-width: 1.1em;
  margin-right: .35rem;
  font-family: var(--font-family-data);
  font-weight: var(--font-weight-semibold);
}

.status-with-detail {
  display: grid;
  width: 100%;
  grid-template-columns: 1.1em minmax(0, 1fr);
  column-gap: .35rem;
  align-items: start;
}

.status-with-detail .status {
  margin-right: 0;
}

.status--yes {
  color: #007b70;
}

.status--no {
  color: #c54b3f;
}

.status--partial {
  color: #be760b;
}

.comparison__notes {
  max-width: 64rem;
  margin-top: var(--space-5);
}

.comparison__notes p {
  max-width: none;
  margin: 0;
  padding: 0;
  color: var(--color-text-muted);
  font-family: ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', monospace;
  font-size: .68rem;
  line-height: 1.6;
}

.comparison__notes p + p {
  margin-top: var(--space-1);
}

@media (max-width: 760px) {
  .comparison__header {
    margin-bottom: var(--space-6);
  }

  .comparison__header p {
    font-size: var(--font-size-md);
  }

  table,
  tbody,
  tr,
  th,
  td {
    display: block;
    width: 100%;
  }

  thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  tbody tr {
    padding: var(--space-4) 0;
  }

  tbody tr:first-child {
    border-top: 2px solid var(--phaeno-neutral-900);
  }

  tbody th {
    padding: 0 0 var(--space-3);
    font-size: var(--font-size-md);
  }

  tbody td {
    display: grid;
    grid-template-columns: minmax(7.5rem, 42%) 1fr;
    gap: var(--space-3);
    padding: .35rem 0;
  }

  tbody td::before {
    content: attr(data-label);
    color: var(--phaeno-neutral-600);
    font-family: var(--font-family-sans);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
  }

  tbody td:nth-child(2)::before {
    color: var(--phaeno-rna-600);
  }

  .metrics-start {
    margin-top: var(--space-4);
  }
}
</style>
