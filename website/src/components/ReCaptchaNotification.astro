---
import { getMessages } from '@/i18n/messages'
import type { SupportedLocale } from '@/i18n/locales'

interface Props {
  locale?: SupportedLocale
}

const { locale = 'en-US' } = Astro.props as Props
const text = getMessages(locale).contact.recaptcha
---

<div data-phaeno-search-ignore>
  <p class="mt-2 text-xs text-gray-500 text-center">
    {text.prefix}
    <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="underline mx-1">{text.privacyPolicy}</a>
    {text.conjunction}
    <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer" class="underline mx-1">{text.termsOfService}</a>
    {text.suffix}
  </p>
</div>
